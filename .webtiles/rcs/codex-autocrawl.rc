# MiBe automation prototype -- current DCSS Lua API (2026-09)
# Autonomous trial: red encounters currently use the yellow combat policy.
default_manual_training = true
autofight_stop = 0
autofight_caught = true
rest_wait_both = true
explore_delay = -1
travel_delay = -1
rest_delay = -1
show_more = false
force_more_message =
explore_stop = shop,greedy_pickup_smart
bindkey = [^D] CMD_LUA_CONSOLE

<
-- MiBe conservative automation core for current DCSS Lua API.
-- Paste the body between < ... > in .crawlrc.

crawl.more_autoclear(true)

-- Tactical policy knobs. Keep defaults stable during structural cleanup;
-- experiments change this block and log the exact tested revision.
AUTOCrawl_TACTICS = {
  curing_hp = 70, poison_remaining_fraction = 0.6,
  heal_hp = 45, escape_hp = 55, fear_enemy_count = 2,
  allies_hp = 70, allies_enemy_count = 3, allies_cooldown = 20,
  hand_hp = 80, hand_cooldown = 40,
  haste_hp = 65, might_hp = 75,
  berserk_hp = 55, crowd_berserk = true, berserk_enemy_count = 3,
  positioning = true, position_enemy_count = 3, position_moves = 6,
  position_waits = 3,
  encounter_control = true, encounter_memory = 8, retreat_hp = 65,
  retreat_moves = 6,
  early_commit = false, early_commit_xl = 4, early_commit_hp = 20,
  hidden_memory = 20, blind_probe_limit = 3,
  hidden_hand_cooldown = 8,
  steam_charge = true, steam_charge_memory = 12, steam_charge_steps = 8,
  approach_mode = 2, approach_waits = 4, approach_backsteps = 2,
  sigmund_mode = 1, -- 1 no lure; 2 early charge/rage; 3 unseen withdrawal
  debug_encounters = false,
  steam_debug = false, -- diagnostic single-action replay; never a benchmark
  steam_debug_entry = false, -- start at D:6 arrival, record notes automatically
  combat_wands = true, charm_min_chance = 60, mindburst_min_chance = 65,
}

-- Diagnostic breakpoints are opt-in and never benchmark wins or stalls.
AUTOCrawl_DEBUG_NAMES = {lodul=true}
AUTOCrawl_DEBUG_STATE = AUTOCrawl_DEBUG_STATE or {seen={},paused=false}
AUTOCrawl_WAND_STATE = AUTOCrawl_WAND_STATE or {active=false}

-- Editable progression plan. A stage covers every floor in [from, to].
-- Alternative groups resolve to the branch actually generated in this game.
-- Set enabled=false to restore the old Dungeon-only stair-survey trial.
AUTOCrawl_ROUTE = {
  enabled = true,
  allow_partial = true, -- inaccessible areas remain explicitly labelled partial
  skip_runed_vaults = true,
  stages = {
    {branch="D", from=1, to=11},
    {branch="Lair", from=1, to=5},
    {branch="D", from=12, to=12},
    {branch="Orc", from=1, to=2},
    {branch="D", from=13, to=15},
    {branch="wet", from=1, to=3},
    {branch="dry", from=1, to=3},
    {branch="wet", from=4, to=4, rune=true},
    {branch="dry", from=4, to=4, rune=true},
    {branch="Elf", from=1, to=2},
    {branch="Vaults", from=1, to=4, min_runes=2},
    {branch="Depths", from=1, to=4},
    {branch="Vaults", from=5, to=5, rune=true},
    {branch="Zot", from=1, to=5, min_runes=3},
  }
}
ROUTE_STATE = ROUTE_STATE or {index=1, done={}, entrances={}, choices={}}
-- Optional user callbacks: autocrawl_route_stage_enter(stage, branch),
-- autocrawl_route_stage_complete(stage, branch), autocrawl_route_blocked(reason),
-- autocrawl_route_complete(). The default endpoint is Zot:5 explored, NOT a win.

BOT = BOT or {
  floor_done = {},
  floor_partial = {},
  failed_entries = {},
  partial_reason = {},
  red_announced = false,
  blind_pending = false,
  blind_target = nil,
  escape_after_blind = false,
  noop_warning = false,
  disturbance_warning = false,
  disturbance_announced = false,
  disturbance_turns = 0,
  paused = false,
  pending_equip_slot = nil,
  dive = { phase = "normal" }
}

local function say(s)
  crawl.mpr("[MiBe bot] " .. s)
end

local function level_key()
  return tostring(you.branch()) .. ":" .. tostring(you.depth())
end

local function feat_here()
  return tostring(view.feature_at(0, 0) or "")
end

local function regular_up(f)
  f = f or feat_here()
  return f:find("stone_stairs_up", 1, true) ~= nil
end

local function regular_down(f)
  f = f or feat_here()
  return f:find("stone_stairs_down", 1, true) ~= nil
end

local function item_class(it)
  if not it then return "" end
  return string.lower(tostring(it.class(true) or ""))
end

local function item_name(it)
  if not it then return "" end
  return string.lower(tostring(it.name() or ""))
end

local function inv_letter(it)
  if not it or it.slot == nil then return nil end
  return items.index_to_letter(it.slot)
end

local function hp_percent()
  local hp, mhp = you.hp()
  if not mhp or mhp <= 0 then return 100 end
  return math.floor(100 * hp / mhp)
end

local function berserk_recovering()
  return you.slowed() or you.exhausted()
      or (you.status and you.status("on berserk cooldown"))
end

-- Synchronous Crawl actions may spend a turn before turns() increments.
-- All fallbacks must use this test, never the counter alone.
local function turn_spent(start_turn)
  return (you.turn_is_over and you.turn_is_over()) or you.turns() ~= start_turn
end

-- A command sequence owns its menu input. Message callbacks must not append
-- target keys behind these cancellation guards (see blind-blink regression).
local function guarded_keys(keys)
  crawl.process_keys(keys .. "\027\027\027")
end

local function movement_locked()
  return you.transform() == "tree" or you.status("immotile")
      or you.status("fortress blast charging")
end

local MOVE_KEYS = { "h", "j", "k", "l", "y", "u", "b", "n" }
local MOVE_DELTAS = {
  {-1, 0}, {0, 1}, {0, -1}, {1, 0},
  {-1, -1}, {1, -1}, {-1, 1}, {1, 1},
}

-- CMD_AUTOFIGHT itself rejects confused players before taking a turn.  Use
-- ordinary movement commands instead: Crawl's confused-movement handler then
-- stumbles/attacks as appropriate and still advances the game.
local CONFUSED_MOVE_COMMANDS = {
  ["-1:1"] = "CMD_MOVE_DOWN_LEFT",
  ["0:1"] = "CMD_MOVE_DOWN",
  ["1:-1"] = "CMD_MOVE_UP_RIGHT",
  ["0:-1"] = "CMD_MOVE_UP",
  ["-1:-1"] = "CMD_MOVE_UP_LEFT",
  ["-1:0"] = "CMD_MOVE_LEFT",
  ["1:1"] = "CMD_MOVE_DOWN_RIGHT",
  ["1:0"] = "CMD_MOVE_RIGHT",
}

local DISTURBANCE_ATTACK_COMMANDS = {
  "CMD_ATTACK_UP_LEFT", "CMD_ATTACK_UP", "CMD_ATTACK_UP_RIGHT",
  "CMD_ATTACK_LEFT", "CMD_ATTACK_RIGHT",
  "CMD_ATTACK_DOWN_LEFT", "CMD_ATTACK_DOWN", "CMD_ATTACK_DOWN_RIGHT",
}

local function map_key(x, y)
  return tostring(x) .. ":" .. tostring(y)
end

local function known_map()
  local cells = {}
  for _, cell in pairs(view.get_map()) do
    if cell and cell.x ~= nil and cell.y ~= nil then
      cells[map_key(cell.x, cell.y)] = cell
    end
  end
  return cells
end

local function passable(cell)
  return cell and (cell.traversable or (cell.x == 0 and cell.y == 0))
      and cell.feature ~= "enter_shop"
      and not cell.unsafe and not cell.excluded
end

local function can_step(cells, x, y, dx, dy, blocked)
  local nx, ny = x + dx, y + dy
  local next_cell = cells[map_key(nx, ny)]
  if not passable(next_cell) or blocked[map_key(nx, ny)] then return false end
  -- Custom movement must not bump-attack allies or neutral creatures.
  local occupant=next_cell.monster
  if occupant and (not occupant.attitude or occupant:attitude()~=0) then return false end
  -- Withheld is relative to the real player, not a hypothetical BFS node.
  -- Check only the step we will actually execute, then replan next turn.
  if x == 0 and y == 0 and view.withheld and view.withheld(nx, ny)
      and not you.confused() then return false end
  if not next_cell.bot_escape_exclusion and view.is_safe_square
      and not view.is_safe_square(nx, ny) then
    return false
  end

  -- Crawl permits diagonal movement between walls. Only the destination
  -- needs to be passable; checking the two side cells strands diagonal halls.
  return true
end

local function bfs(cells, blocked, goal_fn)
  local start = map_key(0, 0)
  local queue_x, queue_y, queue_key = {0}, {0}, {start}
  local seen, first_step = {[start] = true}, {}
  local head = 1

  while head <= #queue_key do
    local x, y, here = queue_x[head], queue_y[head], queue_key[head]
    head = head + 1

    if goal_fn and here ~= start and goal_fn(cells[here]) then
      return seen, first_step, first_step[here]
    end

    for i, delta in ipairs(MOVE_DELTAS) do
      local dx, dy = delta[1], delta[2]
      local nx, ny = x + dx, y + dy
      local next_key = map_key(nx, ny)
      if not seen[next_key] and can_step(cells, x, y, dx, dy, blocked) then
        seen[next_key] = true
        first_step[next_key] = (here == start) and MOVE_KEYS[i]
            or first_step[here]
        queue_x[#queue_x + 1] = nx
        queue_y[#queue_y + 1] = ny
        queue_key[#queue_key + 1] = next_key
      end
    end
  end
  return seen, first_step, nil
end

local function safe_probe_command(scan, preferred)
  local function allowed(cmd)
    for key,move in pairs(CONFUSED_MOVE_COMMANDS) do
      if cmd==(move:gsub("CMD_MOVE_","CMD_ATTACK_")) then
        local cell=scan.cells[key]
        local m=cell and cell.monster
        return not m or (m.attitude and m:attitude()==0)
      end
    end
    return false
  end
  if preferred and allowed(preferred) then return preferred end
  for offset=0,7 do
    local cmd=DISTURBANCE_ATTACK_COMMANDS[((BOT.disturbance_turns or 0)+offset)%8+1]
    if allowed(cmd) then return cmd end
  end
  return "CMD_WAIT"
end

local function explore_frontier(scan, allow_native_explore)
  local custom = BOT.custom_exploring_level == level_key()
  -- Native exploration visits loot as well as unexplored territory. Keep
  -- custom movement only for interruptions that native exploration cannot handle.
  if allow_native_explore and not scan.any and not custom then
    -- Match Crawl's bundled qw bot: process the command with trailing Escape
    -- guards so modal menus reached by native exploration cannot strand it.
    guarded_keys("o")
    return true
  end

  -- If we are already on a frontier, enter one adjacent unknown square.
  -- Do this before choosing another frontier: otherwise two adjacent frontier
  -- cells can keep selecting each other without ever revealing new territory.
  if scan.cells[map_key(0, 0)]
      and scan.cells[map_key(0, 0)].frontier then
    for i, delta in ipairs(MOVE_DELTAS) do
      local dx, dy = delta[1], delta[2]
      if not scan.cells[map_key(dx, dy)] and view.can_reach(dx, dy) then
        crawl.sendkeys(MOVE_KEYS[i])
        return true
      end
    end
  end

  local _, _, step = bfs(scan.cells, scan.blocked,
      function(cell) return cell.frontier end)

  -- No frontier is not proof of completion: loot or blocked areas may remain.
  -- Only the floor-completion/stair-survey path may initiate a descent.
  if step then
    crawl.sendkeys(step)
    return true
  end

  if custom and not scan.any then
    BOT.custom_exploring_level = nil
    guarded_keys("o")
    return true
  end

  -- A sealed arrival pocket may contain only an isolated monster. Returning
  -- upstairs is safe recovery, not permission to descend an unfinished floor.
  if regular_up() then
    crawl.sendkeys("<")
    return true
  end
  local _, _, retreat = bfs(scan.cells, scan.blocked,
      function(cell) return regular_up(cell.feature) end)
  if retreat then
    crawl.sendkeys(retreat)
    return true
  end

  if not BOT.paused then
    say("no safe known frontier -- automation paused.")
    BOT.paused = true
  end
  return true
end

local function visit_shop_action(scan)
  -- Native explore stops when it discovers shops (explore_stop = shop).
  -- Visit known unvisited shops under our control before restarting it, so
  -- native greedy travel cannot open an unattended menu mid-run.
  local cells = {}
  for key, cell in pairs(scan.cells) do
    cells[key] = cell
    if cell.feature == "enter_shop" and cell.unvisited then
      local copy = {}
      for k,v in pairs(cell) do copy[k] = v end
      copy.feature = "floor"
      copy.bot_shop = true
      cells[key] = copy
    end
  end
  local _, _, step = bfs(cells, scan.blocked,
      function(cell) return cell.bot_shop end)
  if step then crawl.sendkeys(step); return true end
  return false
end

local function unsafe_square_action(scan)
  if not view.is_safe_square or view.is_safe_square(0, 0) then return false end
  for i, delta in ipairs(MOVE_DELTAS) do
    if can_step(scan.cells, 0, 0, delta[1], delta[2], scan.blocked) then
      crawl.sendkeys(MOVE_KEYS[i])
      return true
    end
  end
  -- A cloud can cover the entire corridor. Waiting advances its expiration;
  -- auto-explore would refuse without spending any time.
  crawl.do_commands({"CMD_WAIT"})
  return true
end

-- -------------------------------------------------------------------------
-- Threat scan / combat
-- threat(): 0 dark grey, 1 light grey, 2 yellow, 3 red.
-- -------------------------------------------------------------------------

local function scan_hostiles()
  local out = {
    any = false,
    worst = -1,
    reachable_any = false,
    reachable_worst = -1,
    reachable_adjacent = false,
    yellow_adjacent = false,
    monsters = {},
    cells = known_map(),
    blocked = {},
  }

  for _, cell in pairs(out.cells) do
    if cell.visible and cell.monster then
      local m = cell.monster
      local name = m.name and m:name() or ""
      if m:attitude() == 0 and not m:is_firewood()
          and name ~= "butterfly" and name ~= "orb of destruction" then
        local item = { x = cell.x, y = cell.y, monster = m, threat = m:threat() }
        out.monsters[#out.monsters + 1] = item
        out.blocked[map_key(cell.x, cell.y)] = true
        out.any = true
        if item.threat > out.worst then out.worst = item.threat end
      end
    end
  end

  out.seen, out.first_step = bfs(out.cells, out.blocked, false)

  for _, item in ipairs(out.monsters) do
    local adjacent = math.max(math.abs(item.x), math.abs(item.y)) == 1
    local reachable = adjacent and view.can_reach(item.x, item.y)
    if not reachable then
      for _, delta in ipairs(MOVE_DELTAS) do
        local goal = map_key(item.x + delta[1], item.y + delta[2])
        if out.seen[goal] then
          reachable = true
          break
        end
      end
    end
    item.reachable = reachable
    if reachable then
      out.reachable_any = true
      if item.threat > out.reachable_worst then
        out.reachable_worst = item.threat
      end
      if adjacent then
        out.reachable_adjacent = true
        if item.threat == 2 then out.yellow_adjacent = true end
      end
    end
  end
  return out
end

function autocrawl_debug_report()
  local scan=scan_hostiles()
  local report={"turn="..you.turns().." floor="..level_key().." HP="..you.hp().."/"..select(2,you.hp()),
    "berserk="..tostring(you.berserk()).." recovering="..tostring(berserk_recovering())}
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    report[#report+1]=m:name().." ("..enemy.x..","..enemy.y..") threat="..enemy.threat
        .." charm="..tostring(m:defeat_wl("Charm",true))
        .." mindburst="..tostring(m:defeat_wl("Mindburst",true))
  end
  for _,it in ipairs(items.inventory()) do
    local kind=item_class(it)
    if kind=="wand" or kind=="potion" or kind=="scroll" then
      report[#report+1]=inv_letter(it)..") "..item_name(it)
          ..(kind=="wand" and " damage="..tostring(it.evoke_damage) or "")
    end
  end
  AUTOCrawl_DEBUG_STATE.report=report
  for _,line in ipairs(report) do say("DEBUG "..line) end
  return report
end

function autocrawl_debug_resume()
  AUTOCrawl_DEBUG_STATE.paused=false
  BOT.paused=false
  say("debug breakpoint resumed; already-seen uniques will not retrigger")
end

local function debug_encounter_pause(scan)
  if not AUTOCrawl_TACTICS.debug_encounters then return false end
  for _,enemy in ipairs(scan.monsters) do
    local name=enemy.monster:name():lower()
    if AUTOCrawl_DEBUG_NAMES[name] and not AUTOCrawl_DEBUG_STATE.seen[name] then
      AUTOCrawl_DEBUG_STATE.seen[name]=true
      AUTOCrawl_DEBUG_STATE.paused=true
      BOT.paused=true
      say("DEBUG PAUSE: encountered "..name.."; inspect before combat")
      autocrawl_debug_report()
      return true
    end
  end
  return false
end

local function use_known_consumable(kind, name)
  if you.berserk() or (kind=="scroll" and (you.confused() or you.silenced())) then return false end
  BOT.item_attempts=BOT.item_attempts or {}
  local turn=you.turns()
  if BOT.item_attempts[name]==turn then return false end
  for _,it in ipairs(items.inventory()) do
    if item_class(it)==kind and it.is_identified and item_name(it):find(name,1,true) then
      BOT.item_attempts[name]=turn
      say("survival: "..name)
      -- Known fear opens a non-directional area preview in this Crawl build.
      -- Confirm it before the guards; Escape alone cancels without using it.
      local confirm=((kind=="scroll" and name=="fear")
          or (kind=="potion" and name=="invisibility")) and "f" or ""
      guarded_keys((kind=="potion" and "q" or "r")..inv_letter(it)..confirm)
      return turn_spent(turn)
    end
  end
  return false
end

local function survival_ability(name, cooldown)
  if not you.ability_info then return false end
  BOT.ability_attempts=BOT.ability_attempts or {}
  local turn=you.turns()
  if turn-(BOT.ability_attempts[name] or -10000)<cooldown then return false end
  for _,info in ipairs(you.ability_info(name) or {}) do
    if info[2] then
      BOT.ability_attempts[name]=turn
      say("survival: "..name)
      return you.activate_ability(name,0,0) and true or false
    end
  end
  return false
end

-- An encounter outlives individual LOS scans. Observation never spends a turn;
-- execution below chooses at most one action, then ready() observes again.
local function observe_encounter(scan)
  if not AUTOCrawl_TACTICS.encounter_control then BOT.encounter=nil; return end
  local turn,hp=you.turns(),hp_percent()
  local e=BOT.encounter
  if not e or e.level~=level_key() then
    e={level=level_key(),phase="idle",hp=hp,last_seen=-10000,
       peak=0,retreats=0,started=turn}
    BOT.encounter=e
  end
  local unseen=BOT.disturbance_warning and
      turn-(BOT.disturbance_last_seen or -10000)<=AUTOCrawl_TACTICS.encounter_memory
  local visible_caster=false
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    local name=m and m.name and m:name() or ""
    local invisible=false
    for _,spell in ipairs(m and m.spells and m:spells() or {}) do
      if tostring(spell):lower():find("invisibility",1,true) then invisible=true end
    end
    if invisible then
      if not e.hidden_caster or e.hidden_caster.name~=name then
        say("threat memory: "..name.." can turn invisible")
      end
      e.hidden_caster={name=name,seen=turn,threat=enemy.threat or scan.worst}
      visible_caster=true
    end
  end
  if e.hidden_caster then
    if unseen then e.hidden_caster.seen=turn end
    if turn-e.hidden_caster.seen>AUTOCrawl_TACTICS.hidden_memory then
      say("threat memory expired: "..e.hidden_caster.name)
      e.hidden_caster=nil
    end
  end
  e.hidden_missing=e.hidden_caster~=nil and not visible_caster
  unseen=unseen or e.hidden_missing
  local damaged=hp<e.hp
  e.hp=hp
  if scan.any or unseen or (damaged and e.phase~="idle") then e.last_seen=turn end
  local active=scan.any or unseen or turn-e.last_seen<=AUTOCrawl_TACTICS.encounter_memory
  local count=#scan.monsters
  if active and e.phase=="idle" then
    e.started=turn; e.peak=0; e.retreats=0
    e.approach=nil
    e.throws=0; e.throw_last=nil
  end
  e.peak=math.max(e.peak,count)
  e.active=active
  e.unseen=unseen
  local cooldown=berserk_recovering()
  local phase="idle"
  if active then
    if not you.berserk() and (hp<AUTOCrawl_TACTICS.retreat_hp or
        (cooldown and scan.any) or (unseen and (damaged or
          (you.poisoned and you.poisoned()) or you.confused()))) then
      phase="disengage"
    elseif not scan.any then phase="recover"
    elseif scan.reachable_adjacent or you.berserk() then phase="fight"
    else phase="prepare" end
  elseif hp<100 or cooldown or you.berserk() then phase="recover" end
  if phase~=e.phase then
    say("encounter: "..e.phase.." -> "..phase.." (HP "..math.floor(hp).."%, peak "..e.peak..")")
    e.phase=phase
  end
end

local function survival_action(scan)
  if you.berserk() then return false end
  local policy=AUTOCrawl_TACTICS
  local hp=hp_percent()
  local poison=you.poisoned and you.poisoned()
  local projected_hp=hp*0.01*select(2,you.hp())
  if poison and ((you.poison_survival and
      you.poison_survival()<projected_hp*policy.poison_remaining_fraction)
      or hp<policy.curing_hp) then
    if use_known_consumable("potion","curing") then return true end
  end
  if hp<policy.heal_hp and use_known_consumable("potion","heal wounds") then return true end
  local encounter=BOT.encounter
  if not scan.any and not (encounter and encounter.active) then return false end
  local count=#scan.monsters
  -- Protect against confusion before berserk removes access to abilities/items.
  -- The remembered caster remains relevant even when other monsters are visible.
  if hp<policy.escape_hp or (encounter and encounter.phase=="disengage") then
    if not you.status("about to teleport") and use_known_consumable("scroll","teleportation") then return true end
    if count>=policy.fear_enemy_count and use_known_consumable("scroll","fear") then return true end
  end
  BOT.hidden_hand_uses=BOT.hidden_hand_uses or {}
  local uses=encounter and BOT.hidden_hand_uses[encounter.level] or 0
  uses=uses or 0
  if encounter and encounter.hidden_caster and uses<2 and not you.status("regenerating")
      and survival_ability("Trog's Hand",policy.hidden_hand_cooldown) then
    BOT.hidden_hand_uses[encounter.level]=uses+1
    return true
  end
  if hp<policy.allies_hp and (count>=policy.allies_enemy_count or scan.worst>=3)
      and survival_ability("Brothers in Arms",policy.allies_cooldown) then return true end
  if hp<policy.hand_hp and (scan.reachable_adjacent or (encounter and encounter.unseen))
      and not you.status("regenerating") and survival_ability("Trog's Hand",policy.hand_cooldown) then return true end
  if hp<policy.haste_hp and not you.status("hasted") and use_known_consumable("potion","haste") then return true end
  if hp<policy.might_hp and scan.reachable_adjacent and not you.status("mighty")
      and use_known_consumable("potion","might") then return true end
  return false
end

-- Deliberately conservative firing corridor: reject ambiguous terrain or any
-- intervening creature in the bounding rectangle. False negatives are safer
-- than assuming the engine's alternate beam rays cannot hit an ally.
local function wand_clear_shot(scan,x,y)
  for cx=math.min(0,x),math.max(0,x) do
    for cy=math.min(0,y),math.max(0,y) do
      if not (cx==0 and cy==0) and not (cx==x and cy==y) then
        local c=scan.cells[map_key(cx,cy)]
        if not c or not c.visible or not c.traversable or c.monster
            or c.invisible_monster then return false end
      end
    end
  end
  return true
end

local function wand_scores(scan)
  local hp,mhp=you.hp()
  local hp_score=math.max(0,math.min(10,math.floor(10*hp/mhp)))
  local threat_score=0
  for _,enemy in ipairs(scan.monsters) do
    threat_score=threat_score+(enemy.threat==3 and 6 or enemy.threat==2 and 1 or 0)
  end
  return hp_score,threat_score
end

local function wand_cap_note(state)
  if state.uses<4 then return end
  local names={}
  for name,count in pairs(state.enemies) do names[#names+1]=count.."x "..name end
  table.sort(names)
  local roster=table.concat(names,", ")
  if state.noted_roster==roster then return end
  state.noted_roster=roster
  local message="WAND CAP 4/4: encounter "..state.started.." at "..state.level
      .."; enemies seen (peak simultaneous per kind): "..roster
  say(message)
  if crawl.take_note then crawl.take_note(message) end
end

local function observe_wand_encounter(scan)
  local state=AUTOCrawl_WAND_STATE
  if not state.active and scan.any then
    state={active=true,uses=0,last=-10000,charm_last=-10000,
      started=you.turns(),level=level_key(),enemies={}}
    AUTOCrawl_WAND_STATE=state
  end
  if not state.active then return state end
  local counts={}
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    local name=(m and m.name and m:name() or "unknown").." [threat "..tostring(enemy.threat).."]"
    counts[name]=(counts[name] or 0)+1
  end
  for name,count in pairs(counts) do
    state.enemies[name]=math.max(state.enemies[name] or 0,count)
  end
  wand_cap_note(state)
  -- Leaving LOS or changing floors must not replenish the budget. End only
  -- after encounter memory expires and the character is fully recovered.
  if not scan.any and not (BOT.encounter and BOT.encounter.active)
      and not BOT.disturbance_warning and hp_percent()>=100
      and not you.berserk() and not berserk_recovering() then
    state.active=false
  end
  return state
end

local function wand_options(scan)
  local options={}
  local state=observe_wand_encounter(scan)
  if not items or not items.inventory
      or not AUTOCrawl_TACTICS.combat_wands or not scan.any
      or you.berserk() or you.confused() then return options end
  local turn=you.turns()
  local hp_score,threat_score=wand_scores(scan)
  if hp_score>=threat_score or state.last==turn or state.uses>=4 then return options end
  local ally=false
  for _,c in pairs(scan.cells) do
    if c.visible and c.monster and c.monster:attitude()~=0 then ally=true end
  end
  for _,it in ipairs(items.inventory()) do
    if item_class(it)=="wand" and it.is_identified and (it.plus or 0)>0 then
      local name=item_name(it)
      local kind=name:find("charming",1,true) and "charming"
          or name:find("mindburst",1,true) and "mindburst"
          or name:find("warping",1,true) and "warping"
      if kind then
        for _,enemy in ipairs(scan.monsters) do
          local x,y,m=enemy.x,enemy.y,enemy.monster
          local distance=math.max(math.abs(x),math.abs(y))
          if distance<=(kind=="warping" and 5 or 7) and wand_clear_shot(scan,x,y) then
            local chance,score,reason=nil,nil,nil
            if kind=="charming" then
              chance=m:defeat_wl("Charm",true)
              if not ally and #scan.monsters>=2 and scan.worst>=2 and enemy.threat>=1
                  and type(chance)=="number" and chance>=AUTOCrawl_TACTICS.charm_min_chance
                  and turn-state.charm_last>=3 then
                score=100+chance/10+enemy.threat*3-distance
                reason="reduce pack pressure"
              end
            elseif kind=="mindburst" then
              chance=m:defeat_wl("Mindburst",true)
              -- Injury is the visible description bucket, never hidden HP.
              local injury=m:damage_level()
              if type(chance)=="number" and chance>=AUTOCrawl_TACTICS.mindburst_min_chance
                  and enemy.threat>=1 and injury>=3
                  and (scan.worst>=2 or berserk_recovering() or hp_percent()<60) then
                score=65+injury*4+chance/10+enemy.threat
                reason="remove wounded attacker"
              end
            else
              local count,safe=0,distance>1
              for _,c in pairs(scan.cells) do
                if c.visible and math.max(math.abs(c.x-x),math.abs(c.y-y))<=1 then
                  if c.invisible_monster then safe=false end
                  if c.monster then
                    if c.monster:attitude()~=0 then safe=false
                    else count=count+1 end
                  end
                end
              end
              if safe and count>=2 and scan.worst>=2 then
                score=60+count*8; reason="safe blast on "..count.." hostiles"
              end
            end
            if score then options[#options+1]={slot=it.slot,kind=kind,x=x,y=y,
              target=m:name(),chance=chance,score=score,reason=reason} end
          end
        end
      end
    end
  end
  table.sort(options,function(a,b)
    if a.score~=b.score then return a.score>b.score end
    if a.x~=b.x then return a.x<b.x end
    if a.y~=b.y then return a.y<b.y end
    return a.slot<b.slot
  end)
  return options
end

function autocrawl_wand_options() return wand_options(scan_hostiles()) end

local function combat_wand_action(scan)
  local option=wand_options(scan)[1]
  if not option then return false end
  local turn=you.turns()
  local state=AUTOCrawl_WAND_STATE
  -- Rejected shots block same-turn retries but do not consume the cast budget.
  state.last=turn
  if option.kind=="charming" then state.charm_last=turn end
  local hp_score,threat_score=wand_scores(scan)
  say("wand: "..option.kind.." -> "..option.target.." ("..option.x..","..option.y
      ..") "..(option.chance and option.chance.."%; " or "")..option.reason
      .."; HP score "..hp_score.." < threat "..threat_score.."; cast "..(state.uses+1).."/4")
  -- In this checkout item.slot is a category letter, whereas items.fire takes
  -- the backing inventory index. Use the wand-only evoke menu, reset targeting
  -- to the player ('r'), then move to the explicitly evaluated destination.
  local aim=string.rep(option.x<0 and "h" or "l",math.abs(option.x))
      ..string.rep(option.y<0 and "k" or "j",math.abs(option.y))
  guarded_keys("V"..items.index_to_letter(option.slot).."r"..aim.."f")
  local spent=turn_spent(turn)
  if spent then state.uses=state.uses+1; wand_cap_note(state) end
  say("wand result: "..(spent and "action spent; reassess" or "rejected; use ordinary policy"))
  return spent
end

function autocrawl_wand_step() return combat_wand_action(scan_hostiles()) end

-- Conservative opener only: three total throws (including curare) per encounter.
local function throwing_action(scan)
  local e=BOT.encounter
  if not e or e.phase~="prepare" or (e.throws or 0)>=3
      or e.throw_last==you.turns() or scan.worst<2 or you.berserk()
      or you.confused() or berserk_recovering() or movement_locked()
      or BOT.disturbance_warning or e.hidden_missing then return false end
  for _,enemy in ipairs(scan.monsters) do
    if math.max(math.abs(enemy.x),math.abs(enemy.y))<=1 then return false end
  end
  local boom,curare
  for _,it in ipairs(items.inventory()) do
    if item_class(it)=="missile" then
      local n=item_name(it)
      if n:find("boomerang",1,true) then boom=it end
      if n:find("curare",1,true) then curare=it end
    end
  end
  local best,ammo,score
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    local d=math.max(math.abs(enemy.x),math.abs(enemy.y))
    if enemy.threat>=2 and d<=7 and enemy.reachable
        and wand_clear_shot(scan,enemy.x,enemy.y) then
      local it=boom
      if enemy.threat>=3 and curare and m:res_poison()<=0
          and not m:status("slow") and not m:status("poisoned") then it=curare end
      local s=enemy.threat*10-d
      if it and (not score or s>score) then best,ammo,score=enemy,it,s end
    end
  end
  if not best then return false end
  local turn=you.turns(); e.throw_last=turn
  local aim=string.rep(best.x<0 and "h" or "l",math.abs(best.x))
      ..string.rep(best.y<0 and "k" or "j",math.abs(best.y))
  say("throw: "..item_name(ammo).." -> "..best.monster:name().."; "..((e.throws or 0)+1).."/3")
  guarded_keys("F"..items.index_to_letter(ammo.slot).."r"..aim.."f")
  if not turn_spent(turn) then return false end
  e.throws=(e.throws or 0)+1
  crawl.take_note("Throw "..e.throws.."/3: "..item_name(ammo).." -> "..best.monster:name())
  return true
end

local function rejected_autofight_action(scan)
  -- Tab can reject targets it filters internally. Fall back to one ordinary
  -- melee/pursuit step instead of reissuing a turnless failed Tab forever.
  if BOT.autofight_rejected then
    BOT.autofight_rejected = false
    for _, enemy in ipairs(scan.monsters) do
      if enemy.reachable then
        local cmd = CONFUSED_MOVE_COMMANDS[map_key(enemy.x, enemy.y)]
        if cmd then crawl.do_commands({cmd}); return true end
        for _, delta in ipairs(MOVE_DELTAS) do
          local step = scan.first_step[map_key(enemy.x+delta[1], enemy.y+delta[2])]
          if step then crawl.sendkeys(step); return true end
        end
      end
    end
    crawl.do_commands({"CMD_WAIT"})
    return true
  end

  return false
end

-- Bot-owned waypoint 9 provides a stable origin despite native travel, blink
-- and rejected movement. waypoint_delta is PLAYER minus waypoint (not vice versa).
-- Anchors describe this visit; never reuse coordinates from a different floor.
local function observe_recovery_anchor(scan)
  if not travel or not travel.set_waypoint or not travel.waypoint_delta then return end
  local a=BOT.recovery_anchor
  if not a or a.level~=level_key() then
    travel.set_waypoint(9,0,0)
    a={level=level_key(),entry={x=0,y=0}}
    BOT.isolated_recovering=nil
    if regular_up() then a.stairs={x=0,y=0} end
    BOT.recovery_anchor=a
  end
end

local function recovery_wait()
  local a=BOT.recovery_anchor
  if a and a.level==level_key() and travel and travel.waypoint_delta then
    local x,y=travel.waypoint_delta(9)
    if x and y then a.rest={x=x,y=y} end
  end
  crawl.do_commands({"CMD_WAIT"})
  return true
end

local function observe_steam_dragon(scan)
  if not AUTOCrawl_TACTICS.steam_charge then BOT.steam_target=nil; return end
  local a=BOT.recovery_anchor
  if not a or a.level~=level_key() or not travel or not travel.waypoint_delta then return end
  local px,py=travel.waypoint_delta(9)
  if not px or not py then return end
  local best,dist
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    if m and m.name and m:name()=="steam dragon" then
      local d=math.max(math.abs(enemy.x),math.abs(enemy.y))
      if not dist or d<dist then best,dist=enemy,d end
    end
  end
  if best then
    BOT.steam_target={level=level_key(),x=px+best.x,y=py+best.y,
      seen=you.turns(),steps=0}
  elseif BOT.steam_target and (BOT.steam_target.level~=level_key()
      or you.turns()-BOT.steam_target.seen>AUTOCrawl_TACTICS.steam_charge_memory) then
    BOT.steam_target=nil
  end
end

local function steam_charge_action(scan)
  local t=BOT.steam_target
  if not AUTOCrawl_TACTICS.steam_charge or not t or t.level~=level_key()
      or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  local px,py=travel.waypoint_delta(9)
  if not px or not py then return false end
  local tx,ty=t.x-px,t.y-py
  local target=scan.cells[map_key(tx,ty)]
  local visible=target and target.visible and target.monster
      and target.monster.name and target.monster:name()=="steam dragon"
  if not visible and (you.turns()-t.seen>AUTOCrawl_TACTICS.steam_charge_memory
      or t.steps>=AUTOCrawl_TACTICS.steam_charge_steps or (tx==0 and ty==0)) then
    BOT.steam_target=nil; return false
  end
  local cells,steam={},false
  for key,c in pairs(scan.cells) do
    cells[key]=c
    if c.cloud and tostring(c.cloud):lower():find("steam",1,true) then
      steam=true
      if not c.excluded then
        local copy={}
        for k,v in pairs(c) do copy[k]=v end
        copy.unsafe=nil
        copy.bot_escape_exclusion=true -- deliberate steam-only damage acceptance
        cells[key]=copy
      end
    end
  end
  -- A vanished dragon without steam is not an invisible-enemy search target.
  if not visible and not steam then BOT.steam_target=nil; return false end
  if visible and math.max(math.abs(tx),math.abs(ty))==1 then
    -- Ordinary combat retains berserk and its other adjacent-fight decisions.
    return false
  end
  local _,_,step=bfs(cells,scan.blocked,function(c)
    if not c then return false end
    if visible then return math.max(math.abs(c.x-tx),math.abs(c.y-ty))==1 end
    return c.x==tx and c.y==ty
  end)
  if not step then return false end
  t.steps=t.steps+1
  BOT.autofight_rejected=false
  BOT.isolated_recovering=nil
  say("steam charge: "..(visible and "closing on visible dragon" or "last-seen dragon position"))
  if crawl.take_note then crawl.take_note("Steam charge: "..(visible and "visible" or "remembered").." HP "..you.hp()) end
  crawl.sendkeys(step)
  return true
end

-- One visible, unoccupied, legal step, biased away from hostile proximity.
local function cautious_step(scan)
  if movement_locked() or you.confused() then return nil end
  local best,score
  for i,d in ipairs(MOVE_DELTAS) do
    local c=scan.cells[map_key(d[1],d[2])]
    if c and c.visible and not c.monster and not c.invisible_monster
        and can_step(scan.cells,0,0,d[1],d[2],scan.blocked) then
      local s=0
      for _,enemy in ipairs(scan.monsters) do
        local dist=math.max(math.abs(enemy.x-d[1]),math.abs(enemy.y-d[2]))
        s=s-(dist<=1 and 40 or 12/math.max(1,dist))
      end
      if c.feature=="shallow_water" then s=s+2 end
      if not score or s>score then best,score=MOVE_KEYS[i],s end
    end
  end
  return best
end

local function liquid_fire_action(scan)
  if not you.status("liquid fire") and not you.status("on fire") then return false end
  if hp_percent()<25 and not you.berserk()
      and use_known_consumable("potion","heal wounds") then return true end
  local step=cautious_step(scan)
  if step then
    crawl.take_note("Liquid fire: shake-off step HP="..you.hp())
    crawl.sendkeys(step); return true
  end
  -- No safe movement: allow ordinary emergency resources/combat to act.
  return false
end

local function isolated_recovery_action(scan)
  local e=BOT.encounter
  local hp,maxhp=you.hp()
  if scan.reachable_any then BOT.isolated_recovering=nil; return false end
  if not BOT.isolated_recovering and not (scan.any and
      (hp<maxhp or berserk_recovering() or (e and e.phase=="disengage"))) then
    return false
  end
  if hp>=maxhp and not berserk_recovering() and not you.berserk() then
    BOT.isolated_recovering=nil; return false
  end
  BOT.isolated_recovering=true
  -- Never mistake lack of a melee path for immunity to ranged/unseen damage.
  local hazardous=(e and e.unseen) or BOT.disturbance_warning or false
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    -- Engine range includes weapons, spells and wands; self-buffs such as a
    -- bear's berserk are not automatically treated as ranged attacks.
    if not m or not m.range or m:range()>1 then hazardous=true end
  end
  local a=BOT.recovery_anchor
  local x,y
  if a and a.level==level_key() and travel and travel.waypoint_delta then
    x,y=travel.waypoint_delta(9)
  end
  if x and y then
    local candidates={a.stairs or false,a.rest or false,a.entry or false}
    for _,goal in ipairs(candidates) do
      if goal then
        local key=map_key(goal.x-x,goal.y-y)
        local cell=scan.cells[key]
        if cell and passable(cell) then
          if cell.visible and not hazardous then
            say("isolated recovery: anchor in sight; healing")
            return recovery_wait()
          end
          local step=scan.first_step[key]
          if step then
            say("isolated recovery: returning toward anchor")
            crawl.sendkeys(step); return true
          end
        end
      end
    end
  end
  if not hazardous then return recovery_wait() end
  local step=cautious_step(scan)
  if step then
    say("isolated recovery: cautious withdrawal")
    crawl.sendkeys(step); return true
  end
  -- In particular, steam can temporarily block every safe path. Spend one
  -- turn, then rebuild visibility/reachability instead of permanently pausing.
  say("isolated recovery: no safe step; rechecking next turn")
  crawl.do_commands({"CMD_WAIT"})
  return true
end

local function isolated_enemy_action(scan)
  if isolated_recovery_action(scan) then return true end
  if BOT.isolated_recovering then
    -- Unseen-threat handling must not fall through into frontier exploration.
    crawl.do_commands({"CMD_WAIT"}); return true
  end
  -- A visible monster with no known route to an adjacent square is not an
  -- autofight target.  Take one ordinary movement step toward exploration,
  -- rechecking danger after that step.
  if not scan.reachable_any then
    -- Wait only if removing a cloud barrier actually connects us to an
    -- enemy. Clouds inside sealed vaults must never stall the whole floor.
    local without_clouds, has_cloud = {}, false
    for key,cell in pairs(scan.cells) do
      without_clouds[key]=cell
      if cell.cloud and cell.unsafe and not cell.excluded then
        local copy={}
        for k,v in pairs(cell) do copy[k]=v end
        copy.unsafe=nil
        copy.bot_escape_exclusion=true -- hypothetical BFS only; never move here
        without_clouds[key]=copy
        has_cloud=true
      end
    end
    if has_cloud then
      local seen=bfs(without_clouds,scan.blocked or {},false)
      for _,enemy in ipairs(scan.monsters) do
        for _,delta in ipairs(MOVE_DELTAS) do
          if seen[map_key(enemy.x+delta[1],enemy.y+delta[2])] then
            crawl.do_commands({"CMD_WAIT"})
            return true
          end
        end
      end
    end
    -- Do not hand control back to greedy native exploration the moment an
    -- isolated enemy leaves LOS: that can lead straight back to the same loot.
    BOT.custom_exploring_level = level_key()
    return explore_frontier(scan)
  end

  return false
end

local function should_berserk(scan)
  local policy=AUTOCrawl_TACTICS
  if BOT.encounter and BOT.encounter.hidden_caster then
    if BOT.encounter.hidden_missing or #scan.monsters>4 or hp_percent()<40
        or you.berserk() or berserk_recovering() then return false end
    for _,enemy in ipairs(scan.monsters) do
      if enemy.monster and enemy.monster.name
          and enemy.monster:name()==BOT.encounter.hidden_caster.name
          and math.max(math.abs(enemy.x),math.abs(enemy.y))==1 then return true end
    end
    return false
  end
  if you.xl and you.xl()<=6 then
    for _,enemy in ipairs(scan.monsters) do
      local m=enemy.monster
      if m and m.spells and #m:spells()>0 then return false end
    end
  end
  -- If emergency items failed and retreat cannot separate adjacent enemies,
  -- don't let the abstract disengage intent veto the only usable power spike.
  if policy.early_commit and you.xl and you.xl()<=policy.early_commit_xl
      and scan.reachable_adjacent and (scan.worst>=2 or #scan.monsters>=2)
      and hp_percent()>=policy.early_commit_hp
      and not you.berserk() and not berserk_recovering() then
    return true
  end
  local crowded=policy.crowd_berserk and scan.reachable_adjacent
      and #scan.monsters>=policy.berserk_enemy_count
  local e=BOT.encounter
  if e and policy.encounter_control then
    if e.phase=="disengage" then return false end
    -- Do not commit to berserk solely because a large/expanding pack is in LOS.
    -- Require multiple actual melee opponents and a bounded visible group.
    local adjacent=0
    for _,m in ipairs(scan.monsters) do
      if m.reachable and math.max(math.abs(m.x),math.abs(m.y))==1 then adjacent=adjacent+1 end
    end
    crowded=crowded and adjacent>=2 and #scan.monsters<=4
  end
  return (scan.yellow_adjacent or crowded) and hp_percent()>=policy.berserk_hp
      and not you.berserk() and not berserk_recovering()
end

local function positioning_action(scan)
  local policy=AUTOCrawl_TACTICS
  if not policy.positioning or #scan.monsters<policy.position_enemy_count
      or scan.reachable_adjacent or you.berserk() or you.confused()
      or movement_locked() then return false end
  local state=BOT.positioning
  if not state or state.level~=level_key() then
    state={level=level_key(),moves=0,waits=0}
    BOT.positioning=state
  end
  local function openness(x,y)
    local exits=0
    for _,delta in ipairs(MOVE_DELTAS) do
      local cell=scan.cells[map_key(x+delta[1],y+delta[2])]
      -- Unknown terrain must not look like a protective wall.
      if not cell then return 9 end
      if cell.traversable then exits=exits+1 end
    end
    return exits
  end
  local function distance(x,y)
    local nearest=100
    for _,enemy in ipairs(scan.monsters) do
      nearest=math.min(nearest,math.max(math.abs(enemy.x-x),math.abs(enemy.y-y)))
    end
    return nearest
  end
  local current=openness(0,0)
  local best,score=nil,current
  if state.moves<policy.position_moves then
    for i,delta in ipairs(MOVE_DELTAS) do
      local x,y=delta[1],delta[2]
      local cell=scan.cells[map_key(x,y)]
      if cell and cell.visible and (cell.feature=="floor" or cell.feature=="open_door")
          and can_step(scan.cells,0,0,x,y,scan.blocked)
          and distance(x,y)>=math.max(3,distance(0,0)) then
        local degree=openness(x,y)
        if degree<score then best,score=MOVE_KEYS[i],degree end
      end
    end
  end
  if best then
    state.moves=state.moves+1
    say("positioning: stepping toward a narrower approach")
    crawl.sendkeys(best)
    return true
  end
  -- Briefly let melee approach; never wait indefinitely or while taking
  -- ranged damage. Casters are not assumed harmless merely because distant.
  local hp=you.hp()
  local spells=false
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    if not m or not m.spells or #m:spells()>0 then spells=true end
  end
  if current<=3 and not spells and distance(0,0)<=5
      and state.waits<policy.position_waits and (not state.hp or hp>=state.hp) then
    state.hp=hp
    state.waits=state.waits+1
    say("positioning: holding a narrow approach")
    crawl.do_commands({"CMD_WAIT"})
    return true
  end
  return false
end

local function manage_encounter(scan)
  local e=BOT.encounter
  if not e or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  -- A visible reaching caster two tiles away can punish every retreat step.
  -- Close the one-tile gap on safe ground, then let priority melee act.
  if e.hidden_caster and not e.hidden_missing and not scan.reachable_adjacent then
    for _,enemy in ipairs(scan.monsters) do
      if enemy.monster and enemy.monster.name and enemy.monster:name()==e.hidden_caster.name
          and math.max(math.abs(enemy.x),math.abs(enemy.y))==2 then
        for i,d in ipairs(MOVE_DELTAS) do
          if math.max(math.abs(enemy.x-d[1]),math.abs(enemy.y-d[2]))==1
              and can_step(scan.cells,0,0,d[1],d[2],scan.blocked) then
            say("caster engagement: closing the melee gap")
            crawl.sendkeys(MOVE_KEYS[i]); return true
          end
        end
      end
    end
  end
  if e.phase=="prepare" then
    if AUTOCrawl_TACTICS.early_commit and you.xl
        and you.xl()<=AUTOCrawl_TACTICS.early_commit_xl then
      for _,m in ipairs(scan.monsters) do
        if m.monster and m.monster.spells and #m.monster:spells()>0 then return false end
      end
    end
    return positioning_action(scan)
  end
  if e.phase=="disengage" and scan.any and not scan.reachable_adjacent
      and not you.berserk() and e.retreats<AUTOCrawl_TACTICS.retreat_moves then
    -- Bounded retreat on known safe ground only. Do not walk away from melee
    -- attackers or pretend a narrower tile necessarily blocks ranged fire.
    local function distance(x,y)
      local nearest=100
      for _,m in ipairs(scan.monsters) do
        nearest=math.min(nearest,math.max(math.abs(m.x-x),math.abs(m.y-y)))
      end
      return nearest
    end
    local best,score=nil,distance(0,0)
    for i,d in ipairs(MOVE_DELTAS) do
      local c=scan.cells[map_key(d[1],d[2])]
      if c and c.visible and (c.feature=="floor" or c.feature=="open_door")
          and can_step(scan.cells,0,0,d[1],d[2],scan.blocked)
          and distance(d[1],d[2])>score then
        best,score=MOVE_KEYS[i],distance(d[1],d[2])
      end
    end
    if best then e.retreats=e.retreats+1; crawl.sendkeys(best); return true end
  end
  -- Keep the encounter open through recovery. An unseen attacker must still
  -- reach disturbance handling, rather than being rested against indefinitely.
  if e.phase=="recover" and not scan.any and not e.unseen then
    return recovery_wait()
  end
  return false
end

-- Small, bounded first-contact experiments: 1 hold, 2 lure toward the
-- entry/rest anchor then hold, 3 hold only when pursuit would touch frontier.
local function sigmund_action(scan)
  local mode=AUTOCrawl_TACTICS.sigmund_mode
  local e=BOT.encounter
  if mode==0 or not e or not e.hidden_caster or e.hidden_caster.name~="Sigmund"
      or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  local target
  for _,enemy in ipairs(scan.monsters) do
    if enemy.monster and enemy.monster.name and enemy.monster:name()=="Sigmund" then target=enemy end
  end
  local function note(s)
    say("Sigmund policy: "..s)
    if crawl.take_note then crawl.take_note("Sigmund "..mode..": "..s.." HP="..you.hp()) end
  end
  if mode==2 and target then
    local distance=math.max(math.abs(target.x),math.abs(target.y))
    if distance<=2 and hp_percent()>=55 and not you.berserk() and not berserk_recovering()
        and survival_ability("Berserk",20) then note("early rage"); return true end
    if distance>1 then
      local _,_,step=bfs(scan.cells,scan.blocked,function(c)
        return math.max(math.abs(c.x-target.x),math.abs(c.y-target.y))==1
      end)
      if step then note("close visible"); crawl.sendkeys(step); return true end
    end
  end
  if mode==3 and e.hidden_missing and not you.berserk() then
    e.sigmund_retreats=e.sigmund_retreats or 0
    if e.sigmund_retreats<12 and not scan.reachable_adjacent then
      local _,_,step=bfs(scan.cells,scan.blocked,function(c) return regular_up(c.feature) end)
      if regular_up() then note("ascend unseen"); crawl.sendkeys("<"); return true end
      if step then
        e.sigmund_retreats=e.sigmund_retreats+1
        note("withdraw unseen"); crawl.sendkeys(step); return true
      end
    end
    -- Do not chase a disturbance with poisoning already ticking. Let normal
    -- visible combat act, or spend a bounded-memory wait until reassessment.
    if not scan.any then note("hold unseen"); crawl.do_commands({"CMD_WAIT"}); return true end
  end
  return false
end

local function approach_action(scan)
  local mode=AUTOCrawl_TACTICS.approach_mode
  local e=BOT.encounter
  if AUTOCrawl_TACTICS.sigmund_mode~=0 and e and e.hidden_caster
      and e.hidden_caster.name=="Sigmund" then return false end
  if mode==0 or not e or not scan.any or not scan.reachable_any
      or you.berserk() or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  local s=e.approach
  if not s then s={waits=0,moves=0,hp=you.hp()}; e.approach=s end
  if scan.reachable_adjacent then s.done=true; return false end
  if s.done then return false end
  local hp=you.hp()
  if hp<s.hp then s.done=true; return false end -- never wait through damage
  s.hp=hp
  local ranged=false
  local near=100
  for _,enemy in ipairs(scan.monsters) do
    local m=enemy.monster
    if m and m.name and m:name()=="steam dragon" then return false end
    if not m or not m.range or m:range()>1 then ranged=true end
    near=math.min(near,math.max(math.abs(enemy.x),math.abs(enemy.y)))
  end
  -- Do this BEFORE backstepping: breaking LOS to a shooter can reset the
  -- encounter during healing and grant a fresh lure allowance forever.
  -- Genuine disengagement is handled separately by the encounter controller.
  if ranged then s.done=true; return false end
  local function note(action)
    say("approach: "..action)
    if crawl.take_note then crawl.take_note("Approach "..mode..": "..action.." enemies="..#scan.monsters.." HP="..hp) end
  end
  if mode==2 and s.moves<AUTOCrawl_TACTICS.approach_backsteps then
    local a=BOT.recovery_anchor
    local px,py
    if a and a.level==level_key() and travel and travel.waypoint_delta then px,py=travel.waypoint_delta(9) end
    if px and py then
      local goal=a.rest or a.entry
      local gx,gy=goal.x-px,goal.y-py
      local distance=math.max(math.abs(gx),math.abs(gy))
      for i,d in ipairs(MOVE_DELTAS) do
        local c=scan.cells[map_key(d[1],d[2])]
        local away=true
        for _,enemy in ipairs(scan.monsters) do
          if math.max(math.abs(enemy.x-d[1]),math.abs(enemy.y-d[2]))<near then away=false end
        end
        if c and c.visible and not c.frontier and c.feature=="floor" and away
            and math.max(math.abs(gx-d[1]),math.abs(gy-d[2]))<distance
            and can_step(scan.cells,0,0,d[1],d[2],scan.blocked) then
          s.moves=s.moves+1; note("lure"); crawl.sendkeys(MOVE_KEYS[i]); return true
        end
      end
    end
  end
  if mode==3 then
    local frontier=false
    for _,enemy in ipairs(scan.monsters) do
      if enemy.reachable then
        for _,d in ipairs(MOVE_DELTAS) do
          local step=scan.first_step[map_key(enemy.x+d[1],enemy.y+d[2])]
          for i,k in ipairs(MOVE_KEYS) do
            if step==k then
              local cell=scan.cells[map_key(MOVE_DELTAS[i][1],MOVE_DELTAS[i][2])]
              if cell and cell.frontier then frontier=true end
            end
          end
        end
      end
    end
    if not frontier then return false end
  end
  if s.waits<AUTOCrawl_TACTICS.approach_waits then
    s.waits=s.waits+1; note("hold"); crawl.do_commands({"CMD_WAIT"}); return true
  end
  s.done=true
  return false
end

local function combat_action(scan)
  if not scan.any then BOT.positioning=nil; return false end
  if rejected_autofight_action(scan) then return true end
  if not scan.reachable_any then return isolated_enemy_action(scan) end
  if not BOT.encounter and positioning_action(scan) then return true end
  if should_berserk(scan) then
    if you.activate_ability("Berserk", 0, 0) then
      return true
    end
  end

  if AUTOCrawl_TACTICS.steam_charge then
    for _,enemy in ipairs(scan.monsters) do
      if enemy.monster and enemy.monster.name and enemy.monster:name()=="steam dragon" then
        local cmd=CONFUSED_MOVE_COMMANDS[map_key(enemy.x,enemy.y)]
        if cmd then crawl.do_commands({(cmd:gsub("CMD_MOVE_","CMD_ATTACK_"))}); return true end
      end
    end
  end
  local memory=BOT.encounter and BOT.encounter.hidden_caster
  if memory then
    for _,enemy in ipairs(scan.monsters) do
      if enemy.monster and enemy.monster.name and enemy.monster:name()==memory.name then
        local cmd=CONFUSED_MOVE_COMMANDS[map_key(enemy.x,enemy.y)]
        if cmd then crawl.do_commands({(cmd:gsub("CMD_MOVE_","CMD_ATTACK_"))}); return true end
      end
    end
  end
  crawl.sendkeys("\t") -- standard autofight for a reachable target
  return true
end

-- Separate policy boundary so red encounters can gain their own tactics later.
local function red_combat_action(scan)
  local red_scan = {}
  for k, v in pairs(scan) do red_scan[k] = v end
  for _, enemy in ipairs(scan.monsters) do
    if enemy.threat >= 3 and enemy.reachable
        and math.max(math.abs(enemy.x), math.abs(enemy.y)) == 1 then
      red_scan.yellow_adjacent = true
    end
  end
  return combat_action(red_scan)
end

local function encounter_action(scan)
  if scan.worst >= 3 then return red_combat_action(scan) end
  return combat_action(scan)
end

local function mesmerised_action(scan)
  if not (you.mesmerised and you.mesmerised()) then return false end
  -- A stale map or changing beholder must not produce a turnless retry loop.
  if BOT.directional_rejected_at == you.turns() then
    crawl.do_commands({"CMD_WAIT"})
    return true
  end
  local adjacent
  for _, enemy in ipairs(scan.monsters) do
    if math.max(math.abs(enemy.x), math.abs(enemy.y)) == 1
        and view.can_reach(enemy.x, enemy.y)
        and (not adjacent or enemy.threat > adjacent.threat) then
      adjacent = enemy
    end
  end
  if adjacent then
    if should_berserk(scan) and you.activate_ability("Berserk", 0, 0) then return true end
    -- Attack without allowing autofight to choose a forbidden pursuit step.
    local cmd = CONFUSED_MOVE_COMMANDS[map_key(adjacent.x, adjacent.y)]
    crawl.do_commands({(cmd:gsub("CMD_MOVE_", "CMD_ATTACK_"))})
    return true
  end
  local blocked = {}
  for key, cell in pairs(scan.cells) do
    if cell.monster or cell.invisible_monster then blocked[key] = true end
  end
  local _, _, step = bfs(scan.cells, blocked, function(cell)
    for _, enemy in ipairs(scan.monsters) do
      if math.max(math.abs(cell.x-enemy.x), math.abs(cell.y-enemy.y)) == 1 then
        return true
      end
    end
    return false
  end)
  if step then crawl.sendkeys(step)
  else crawl.do_commands({"CMD_WAIT"}) end
  return true
end

local function confused_combat_action(scan)
  if not BOT.confused_announced then
    say("confused -- using direct autofight turns.")
    BOT.confused_announced = true
  end

  -- Aim a normal movement command at the highest-threat reachable adjacent
  -- hostile.  While confused, Crawl may stumble in another direction, but it
  -- can still attack or move and the command consumes a turn.
  local target = nil
  for _, item in ipairs(scan.monsters) do
    if item.reachable and math.max(math.abs(item.x), math.abs(item.y)) == 1
        and (not target or item.threat > target.threat) then
      target = item
    end
  end
  if target then
    local cmd = CONFUSED_MOVE_COMMANDS[map_key(target.x, target.y)]
    if cmd then
      crawl.do_commands({cmd})
      return true
    end
  end

  -- CMD_WAIT consumes a turn even while confused.  Unlike the old `5`
  -- recovery command, it cannot emit "You are too confused!" and re-enter
  -- ready() without advancing the game.
  crawl.do_commands({"CMD_WAIT"})
  return true
end

-- -------------------------------------------------------------------------
-- Manual skilling. Axes focus until calculated mindelay target, then Fighting.
-- For normal melee weapons: each 2 skill removes 0.1 AUT down to min delay;
-- normal heavy weapons bottom out at 0.7 AUT.
-- -------------------------------------------------------------------------

local ALL_SKILLS = {
  "Fighting", "Short Blades", "Long Blades", "Axes", "Maces & Flails",
  "Polearms", "Staves", "Ranged Weapons", "Throwing", "Armour", "Dodging",
  "Stealth", "Shields", "Unarmed Combat", "Spellcasting", "Conjurations",
  "Hexes", "Summonings", "Necromancy", "Translocations", "Fire Magic",
  "Ice Magic", "Air Magic", "Earth Magic", "Alchemy", "Invocations",
  "Evocations", "Shapeshifting"
}

local function train(name, mode, target)
  if you.can_train_skill(name) then
    if target then you.set_training_target(name, target) end
    you.train_skill(name, mode)
  end
end

local function axe_mindelay_target()
  local w = items.equipped_at("Weapon")
  if not w or w.weap_skill ~= "Axes" or not w.delay then
    return 14
  end
  local base = tonumber(w.delay) or 13
  local min_delay = math.min(7, math.floor(base / 2))
  return math.max(0, math.min(27, 2 * (base - min_delay)))
end

local function update_skills()
  -- First shut off everything; then enable only our explicit plan.
  for _, sk in ipairs(ALL_SKILLS) do
    if you.can_train_skill(sk) then you.train_skill(sk, 0) end
  end

  local axe_target = axe_mindelay_target()
  local axe_done = you.skill("Axes") + 0.001 >= axe_target

  train("Axes", axe_done and 0 or 2, axe_target)
  train("Fighting", axe_done and 2 or 1, 22)
  train("Armour", 1, 18)

  if you.skill("Dodging") < 12 then train("Dodging", 1, 12) end
  if items.equipped_at("Shield") and you.skill("Shields") < 12 then
    train("Shields", 1, 12)
  end
  if you.xl() >= 8 and you.skill("Evocations") < 8 then
    train("Evocations", 1, 8)
  end
  for _,it in ipairs(items.inventory()) do
    local n=item_name(it)
    if item_class(it)=="missile" and (n:find("throwing net",1,true)
        or n:find("dart",1,true) or n:find("javelin",1,true)
        or n:find("boomerang",1,true)) then
      if not BOT.throwing_found then crawl.take_note("Throwing training unlocked: "..n) end
      BOT.throwing_found=true
    end
  end
  if BOT.throwing_found and you.skill("Throwing")<4 then train("Throwing",1,4) end
end

-- -------------------------------------------------------------------------
-- Gear pickup and equip.
-- Weapon: highest damage_rating among axes.
-- Armour: highest (base AC + enchantment), slot by slot.
-- Jewellery: simple MiBe utility score; unknown jewellery gets a small score
-- so empty slots get wear-ID'd.
-- -------------------------------------------------------------------------

local function jewellery_type(it)
  if not it then return nil end
  local et = string.lower(tostring(it.equip_type or ""))
  if et == "ring" or et == "amulet" then return et end
  if item_class(it) ~= "jewellery" then return nil end
  local n = item_name(it)
  if n:find("amulet", 1, true) then return "amulet" end
  return "ring"
end

local function is_jewellery(it)
  return jewellery_type(it) ~= nil
end

local function safe_stats(it)
  if not it then return true end
  for prop,fn in pairs({Str="strength",Int="intelligence",Dex="dexterity"}) do
    local delta=(it.artprops or {})[prop] or 0
    if delta<0 and you[fn] then
      local projected=you[fn]()+(it.equipped and 0 or delta)
      if projected<=1 then return false end
    end
  end
  return true
end

local function weapon_score(it)
  if not it or not it.is_weapon or it.weap_skill ~= "Axes" then return -1e9 end
  if not safe_stats(it) then return -1e9 end
  local dr = it.damage_rating()
  dr = tonumber(dr) or 0
  if it.artefact then dr = dr + 0.25 end
  if it.branded then dr = dr + 0.10 end
  return dr
end

local function armour_score(it)
  if not it or item_class(it) ~= "armour" then return -1e9 end
  if not safe_stats(it) then return -1e9 end
  local st = string.lower(tostring(it.subtype() or ""))
  if st == "shield" then return -1e9 end -- weapon damage takes priority here
  local score = (tonumber(it.ac) or 0) + (tonumber(it.plus) or 0)
  if it.artefact then score = score + 0.20 end
  if it.ego(false) then score = score + 0.10 end
  return score
end

local ARMOUR_SLOTS = {
  body = "Armour", cloak = "Cloak", helmet = "Helmet",
  gloves = "Gloves", boots = "Boots"
}

local function pickup_for_bot(it, name)
  if not it or it.is_useless then return nil end
  if it.dropped then return false end
  if item_class(it)=="missile" then
    local n=item_name(it)
    if n:find("throwing net",1,true) or n:find("dart",1,true)
        or n:find("javelin",1,true) or n:find("boomerang",1,true) then return true end
  end
  if it.is_weapon and it.weap_skill == "Axes" then
    local cur = items.equipped_at("Weapon")
    return not cur or weapon_score(it) > weapon_score(cur)
        or (not it.is_identified and (it.artefact or it.branded))
  end
  if item_class(it) == "armour" then
    local slot = ARMOUR_SLOTS[it.subtype()]
    if not slot then return false end
    local cur = items.equipped_at(slot)
    return (not it.is_identified and (it.artefact or it.branded))
        or armour_score(it) > (cur and armour_score(cur) or 0)
  end
  if is_jewellery(it) then return true end
  return nil
end
add_autopickup_func(pickup_for_bot)

-- Serialized scalar shop catalogue. Waypoints 0..7 belong to shopping; 9
-- remains the recovery anchor. No Item userdata survives a ready callback.
local function shop_state()
  ROUTE_STATE.shopping=ROUTE_STATE.shopping or {shops={},checked={},next_slot=0}
  return ROUTE_STATE.shopping
end
local SHOP_RESERVES={curing=3,["heal wounds"]=2,teleportation=2,blinking=1,fear=1,identify=2}
local function shop_offer(it,price,index)
  if it.is_useless or not it.is_identified then return nil end
  local class,name=item_class(it),item_name(it)
  local d={price=price,index=index,name=name,quantity=it.quantity or 1}
  if class=="potion" or class=="scroll" then
    for kind,_ in pairs(SHOP_RESERVES) do
      if name:find(kind,1,true) then d.kind=kind; return d end
    end
  elseif it.is_weapon and it.weap_skill=="Axes" then
    d.slot="Weapon"; d.score=weapon_score(it); return d
  elseif class=="armour" and ARMOUR_SLOTS[it.subtype()] then
    if it.subtype()=="helmet" and name:find("helmet",1,true) then return nil end -- MiBe horns
    d.slot=ARMOUR_SLOTS[it.subtype()]; d.score=armour_score(it); return d
  end
end
local function shop_priority(d)
  if d.price>you.gold() then return nil end
  if d.kind then
    local count,unknown=0,false
    for _,it in ipairs(items.inventory()) do
      local class=item_class(it)
      if class=="potion" or class=="scroll" then
        if not it.is_identified then unknown=true
        elseif item_name(it):find(d.kind,1,true) then count=count+(it.quantity or 1) end
      end
    end
    if d.kind=="identify" and not unknown then return nil end
    if count+d.quantity>SHOP_RESERVES[d.kind] then return nil end
    return d.kind=="identify" and 10 or 100-count
  end
  -- Spend on known, strictly better gear only, leaving emergency cash.
  if not d.slot or d.price>you.gold()-100 then return nil end
  local best=items.equipped_at(d.slot)
  local score=best and (d.slot=="Weapon" and weapon_score(best) or armour_score(best)) or 0
  for _,it in ipairs(items.inventory()) do
    if (d.slot=="Weapon" and it.is_weapon) or
        (item_class(it)=="armour" and ARMOUR_SLOTS[it.subtype()]==d.slot) then
      score=math.max(score,d.slot=="Weapon" and weapon_score(it) or armour_score(it))
    end
  end
  local body=items.equipped_at("Armour")
  if body and item_name(body):find("lear's hauberk",1,true)
      and (d.slot=="Helmet" or d.slot=="Gloves" or d.slot=="Boots") then return nil end
  if d.score>score+0.5 then return 20+math.min(20,d.score-score) end
end
local function shop_catalogue()
  if not items.shop_inventory then return end
  local stock=items.shop_inventory(); if not stock then return end
  local s=shop_state(); local slot
  for n,_ in pairs(s.shops) do
    local x,y=travel.waypoint_delta(n)
    if x==0 and y==0 then slot=n; break end
  end
  if not slot then slot=s.next_slot; s.next_slot=(slot+1)%8; travel.set_waypoint(slot,0,0) end
  local offers={}
  for i,row in ipairs(stock) do
    -- ShopMenu resets to type order on entry; '/' selects price order.
    -- Only unique prices have an unambiguous rank (C++ ties are unstable).
    local rank,ties=1,0
    for _,other in ipairs(stock) do
      if other[2]<row[2] then rank=rank+1 end
      if other[2]==row[2] then ties=ties+1 end
    end
    local d=shop_offer(row[1],row[2],rank)
    if d and ties==1 then offers[#offers+1]=d end
  end
  s.shops[slot]={offers=offers,level=level_key()}
  return slot
end
local function shop_abort(reason)
  local s=shop_state()
  if s.active then
    say("shopping abandoned: "..reason)
    if crawl.take_note then crawl.take_note("Shopping abandoned: "..reason) end
    s.active=nil
  end
end
local function shopping_action(scan)
  local s=shop_state(); local a=s.active
  if not a then
    local done=ROUTE_STATE.done[level_key()]
    if s.checked[level_key()] or ROUTE_STATE.recovery or ROUTE_STATE.pocket
        or not (done=="clear" or (done=="partial" and AUTOCrawl_ROUTE.allow_partial)) then return false end
    if scan.any or (you.feel_safe and not you.feel_safe()) then return false end
    s.checked[level_key()]=true
    a={start=you.turns(),buys=0,failed={}}; s.active=a
  end
  if you.turns()-a.start>300 then shop_abort("travel budget"); return false end
  if BOT.encounter and BOT.encounter.phase=="disengage" then shop_abort("disengage"); return false end
  if scan.any then return false end -- combat owns this turn; resume after recovery
  if you.feel_safe and not you.feel_safe() then shop_abort("unsafe"); return false end
  if a.buys>=4 then s.active=nil; return false end
  local best,priority
  for slot,shop in pairs(s.shops) do
    if not a.failed[slot] then for _,d in ipairs(shop.offers) do
      local p=shop_priority(d)
      if p and (not priority or p>priority or (p==priority and d.price<best.offer.price)) then
        best={slot=slot,offer=d}; priority=p
      end
    end end
  end
  if not best then s.active=nil; return false end
  local x,y=travel.waypoint_delta(best.slot)
  if x==0 and y==0 then
    if feat_here()~="enter_shop" then shop_abort("stale destination"); return false end
    shop_catalogue()
    local d
    for _,offer in ipairs(s.shops[best.slot].offers) do
      if shop_priority(offer) and (not d or shop_priority(offer)>shop_priority(d)) then d=offer end
    end
    if not d or d.index>26 or #items.inventory()>=50 then
      a.failed[best.slot]=true
      -- Unlike a menu action this path queues no input at all. Returning
      -- here left Orc:2 shopping asleep with failed[slot]=true until a key
      -- or reload supplied another decision. Yield once, then skip the shop.
      crawl.do_commands({"CMD_WAIT"}); return true
    end
    local gold=you.gold()
    guarded_keys("</"..string.char(96+d.index).."\rY")
    if gold-you.gold()==d.price then
      a.buys=a.buys+1
      say("shopping bought: "..d.name.." for "..(gold-you.gold()))
      shop_catalogue()
    else shop_abort("purchase rejected") end
    return true
  end
  if a.last==you.turns() then a.noops=(a.noops or 0)+1 else a.noops=0 end
  if a.noops>=2 then shop_abort("no travel progress"); return false end
  a.last=you.turns()
  guarded_keys("G"..best.slot)
  return true
end

local function drop_redundant_gear()
  for _, it in ipairs(items.inventory()) do
    if not it.equipped and not it.artefact and not it.branded then
      local cur
      if it.is_weapon and it.weap_skill == "Axes" then
        cur = items.equipped_at("Weapon")
        if cur and weapon_score(it) <= weapon_score(cur) then
          if it.drop() then return true end
        end
      elseif item_class(it) == "armour" then
        local slot = ARMOUR_SLOTS[it.subtype()]
        cur = slot and items.equipped_at(slot)
        if cur and armour_score(it) <= armour_score(cur) then
          if it.drop() then return true end
        end
      end
    end
  end
  return false
end

local function jewellery_score(it)
  if not it or not is_jewellery(it) then return -1e9 end
  if not safe_stats(it) then return -1e9 end
  if it.is_useless then return -1e9 end
  if not it.is_identified then return 5 end

  local n = item_name(it)
  local p = tonumber(it.plus) or 0
  local s = 1

  if n:find("regeneration", 1, true) then s = s + 40 end
  if n:find("faith", 1, true) then s = s + 30 end
  if n:find("reflection", 1, true) then s = s + 28 end
  if n:find("slaying", 1, true) then s = s + 26 + 4*p end
  if n:find("protection", 1, true) then s = s + 24 + 4*p end
  if n:find("evasion", 1, true) then s = s + 22 + 3*p end
  if n:find("strength", 1, true) then s = s + 18 + 2*p end
  if n:find("resist corrosion", 1, true) then s = s + 19 end
  if n:find("fire", 1, true) then s = s + 18 end
  if n:find("ice", 1, true) or n:find("cold", 1, true) then s = s + 18 end
  if n:find("poison", 1, true) then s = s + 20 end
  if n:find("electric", 1, true) then s = s + 24 end
  if n:find("willpower", 1, true) then s = s + 18 end
  if n:find("see invisible", 1, true) then s = s + 12 end
  if n:find("guardian spirit", 1, true) then s = s + 12 end
  if n:find("acrobat", 1, true) then s = s + 10 end
  if n:find("magic regeneration", 1, true) then s = -100 end
  if it.artefact then s = s + 15 end
  return s
end

local function auto_equip_action()
  -- Steam can hide a monster from our scan while Crawl still considers
  -- changing equipment unsafe. Use the game's check before starting a delay.
  if you.feel_safe and not you.feel_safe() then return false end
  for _,it in ipairs(items.inventory()) do
    if it.equipped and not safe_stats(it) and it.remove and it.remove() then return true end
  end
  -- Complete a jewellery replacement after removing the old piece.
  if BOT.pending_equip_slot ~= nil then
    local it = items.inslot(BOT.pending_equip_slot)
    BOT.pending_equip_slot = nil
    if it and is_jewellery(it) and safe_stats(it) then
      return it.equip() and true or false
    end
  end

  -- Weapon.
  local bestw, bestws = nil, -1e9
  for _, it in ipairs(items.inventory()) do
    local s = weapon_score(it)
    if s > bestws then bestw, bestws = it, s end
  end
  local curw = items.equipped_at("Weapon")
  if bestw and (not curw or bestws > weapon_score(curw) + 0.01) then
    if bestw.equip() then return true end
  end

  -- Lear's hauberk occupies body, head, hands and feet together. Choose its
  -- body plan first so auxiliary-slot upgrades cannot immediately remove it.
  local planned_body, body_score = nil, -1e9
  for _, it in ipairs(items.inventory()) do
    if item_class(it) == "armour" and it.subtype() == "body" then
      local score = armour_score(it)
      if score > body_score then planned_body, body_score = it, score end
    end
  end
  local hauberk = planned_body
      and item_name(planned_body):find("lear's hauberk", 1, true)

  -- Armour by slot, excluding shields and occupied hauberk auxiliaries.
  for subtype, slotname in pairs(ARMOUR_SLOTS) do
    if not (hauberk and (subtype == "helmet" or subtype == "gloves" or subtype == "boots")) then
    local best, bs = nil, -1e9
    for _, it in ipairs(items.inventory()) do
      if item_class(it) == "armour"
          and string.lower(tostring(it.subtype() or "")) == subtype then
        local s = armour_score(it)
        if s > bs then best, bs = it, s end
      end
    end
    local cur = items.equipped_at(slotname)
    if best and ((not cur and bs > 0) or (cur and bs > armour_score(cur) + 0.01)) then
      if best.equip() then return true end
    end
    end
  end

  -- Amulet.
  local besta, bas = nil, -1e9
  for _, it in ipairs(items.inventory()) do
    if jewellery_type(it) == "amulet" then
      local s = jewellery_score(it)
      if s > bas then besta, bas = it, s end
    end
  end
  local cura = items.equipped_at("Amulet")
  if besta and (not cura or bas > jewellery_score(cura) + 1) then
    if not cura then
      if besta.equip() then return true end
    elseif cura.remove() then
      BOT.pending_equip_slot = besta.slot
      return true
    end
  end

  -- Rings: fill free slots first, otherwise replace the weaker ring.
  local ring_candidates = {}
  for _, it in ipairs(items.inventory()) do
    if jewellery_type(it) == "ring" and not it.equipped then
      table.insert(ring_candidates, it)
    end
  end
  table.sort(ring_candidates, function(a,b)
    return jewellery_score(a) > jewellery_score(b)
  end)
  local br = ring_candidates[1]
  if br and not safe_stats(br) then br=nil end
  if br then
    local r1 = items.equipped_at("Ring", 1)
    local r2 = items.equipped_at("Ring", 2)
    if not r1 or not r2 then
      if br.equip() then return true end
    else
      local weak = jewellery_score(r1) <= jewellery_score(r2) and r1 or r2
      if jewellery_score(br) > jewellery_score(weak) + 1 then
        if weak.remove() then
          BOT.pending_equip_slot = br.slot
          return true
        end
      end
    end
  end

  return false
end

-- -------------------------------------------------------------------------
-- Stair ID system.
-- Only normal stone upstairs are used as blind-ID safety points.
-- -------------------------------------------------------------------------

local function best_unid_potion()
  local best = nil
  for _, it in ipairs(items.inventory()) do
    if item_class(it) == "potion" and not it.is_identified then
      if not best or (it.quantity or 1) > (best.quantity or 1) then best = it end
    end
  end
  return best
end

local function best_unid_scroll(exclude_slot, duplicates_only)
  local best = nil
  for _, it in ipairs(items.inventory()) do
    if item_class(it) == "scroll" and not it.is_identified
        and it.slot ~= exclude_slot
        and (not duplicates_only or (it.quantity or 1) >= 2) then
      if not best or (it.quantity or 1) > (best.quantity or 1) then best = it end
    end
  end
  return best
end

local function known_identify_scroll()
  for _, it in ipairs(items.inventory()) do
    if item_class(it) == "scroll" and it.is_identified
        and item_name(it):find("identify", 1, true) then
      return it
    end
  end
  return nil
end

-- Let the item-use hook choose once, instead of queuing a letter that can
-- leak into the next command when identification resolves without a menu.
function c_choose_identify()
  BOT.blind_pending = false
  BOT.blind_target = nil
  local target = best_unid_potion() or best_unid_scroll(nil, false)
  return target and inv_letter(target) or ""
end

local function auto_id_action()
  if not regular_up() or you.confused() or you.silenced() then return false end

  -- 1) Blind-read a duplicated unknown scroll.
  local blind = best_unid_scroll(nil, true)
  if blind then
    local potion = best_unid_potion()
    local fallback_scroll = best_unid_scroll(blind.slot, false)
    local target = potion or fallback_scroll

    BOT.blind_pending = true
    BOT.blind_target = target and inv_letter(target) or nil
    guarded_keys("r" .. inv_letter(blind))
    return true
  end

  -- 2) Spend known identify scrolls on unidentified potions.
  local ids = known_identify_scroll()
  local potion = best_unid_potion()
  if ids and potion then
    guarded_keys("r" .. inv_letter(ids))
    return true
  end

  return false
end

local function enchant_choice(weapon)
  local best, score = nil, -1e9
  for _, it in ipairs(items.inventory()) do
    if it.is_enchantable and ((weapon and it.is_weapon)
        or (not weapon and item_class(it) == "armour")) then
      local s = weapon and weapon_score(it) or armour_score(it)
      if it.equipped then s = s + 10000 end
      if s > score then best, score = it, s end
    end
  end
  return best and inv_letter(best) or ""
end

function c_choose_enchant_weapon() return enchant_choice(true) end
function c_choose_enchant_armour() return enchant_choice(false) end
function c_choose_brand_weapon()
  local weapon = items.equipped_at("Weapon")
  if weapon and not weapon.artefact then return inv_letter(weapon) end
  return enchant_choice(true)
end
function c_choose_acquirement()
  -- Deterministic non-interactive baseline; tactical scoring can follow later.
  return 1
end

-- -------------------------------------------------------------------------
-- Stair-dipping safety system. Sort regular downstairs by map coordinates;
-- their order is unchanged by translating player-relative coordinates.
-- Route one step at a time, excluding hatches and branch entrances.
-- -------------------------------------------------------------------------

local function count_down_cycle_targets()
  local targets = {}
  for _, cell in pairs(view.get_map()) do
    if regular_down(cell.feature) then
      targets[#targets+1] = {x=cell.x, y=cell.y}
    end
  end
  table.sort(targets, function(a,b)
    return a.x < b.x or (a.x == b.x and a.y < b.y)
  end)
  return targets
end

local function at_down_index(n)
  local target = count_down_cycle_targets()[n]
  return target and target.x == 0 and target.y == 0 and regular_down()
end

local function goto_down_index(n)
  if at_down_index(n) then return true end
  local target = count_down_cycle_targets()[n]
  if not target then return false end
  local scan = scan_hostiles()
  local _, _, step = bfs(scan.cells, scan.blocked, function(cell)
    return cell.x == target.x and cell.y == target.y
  end)
  if step then crawl.sendkeys(step); return true end
  return false
end

local function start_dive_survey()
  local targets = count_down_cycle_targets()
  BOT.dive = {
    phase = "survey_parent",
    parent = level_key(),
    index = 1,
    total = #targets,
    targets = targets,
    reachable = {},
    active_index = nil,
    child_up_tries = 0,
    commit_pos = 1,
  }
  say("floor clear: stair-dipping before committing deeper.")
end

local function dive_action()
  local d = BOT.dive
  if not d or d.phase == "normal" then return false end

  -- State-only transitions can chain; actual commands return immediately.
  for _ = 1, 20 do
    local here = level_key()

    if d.phase == "survey_parent" then
      if here ~= d.parent then
        d.phase = "survey_child"
      elseif d.index > d.total then
        if #d.reachable == 0 then
          local scan = scan_hostiles()
          local _, _, retreat = bfs(scan.cells, scan.blocked,
              function(cell) return regular_up(cell.feature) end)
          if regular_up() or retreat then
            d.phase = "normal"
            BOT.floor_done[here] = false
            BOT.floor_partial[here] = true
            BOT.partial_reason[here] = "no safe downstairs from this component"
            crawl.sendkeys(regular_up() and "<" or retreat)
            return true
          end
          say("no reachable regular downstair found -- paused.")
          d.phase = "paused"
          return true
        end
        d.phase = "commit_parent"
      else
        if (BOT.failed_entries[d.parent] or {})[d.index] then
          d.index = d.index + 1
        elseif at_down_index(d.index) then
          d.phase = "parent_travel"
        elseif goto_down_index(d.index) then
          return true
        else
          d.index = d.index + 1
        end
      end

    elseif d.phase == "parent_travel" then
      if here ~= d.parent then
        -- Unexpected level change: treat as unsafe and pause.
        say("unexpected level change during stair survey -- paused.")
        d.phase = "paused"
        return true
      elseif regular_down() then
        d.active_index = d.index
        crawl.sendkeys(">")
        d.phase = "survey_descending"
        return true
      else
        -- X> landed on a hatch/branch/other target, or travel failed.
        d.index = d.index + 1
        d.phase = "survey_parent"
      end

    elseif d.phase == "survey_descending" then
      if here ~= d.parent then
        -- Do not commit to sealed stair pockets with no route onward.
        local cells = known_map()
        local seen = bfs(cells, {}, false)
        local onward = false
        for key, cell in pairs(cells) do
          if seen[key] and (cell.frontier or regular_down(cell.feature)) then
            onward = true
            break
          end
        end
        if onward then table.insert(d.reachable, d.active_index) end
        d.phase = "survey_child"
      else
        d.index = d.index + 1
        d.phase = "survey_parent"
      end

    elseif d.phase == "survey_child" then
      -- Combat and recovery have already run before this function.
      if here == d.parent then
        d.index = d.index + 1
        d.phase = "survey_parent"
      elseif regular_up() then
        crawl.sendkeys("<")
        d.phase = "survey_returning"
        return true
      else
        local scan = scan_hostiles()
        local _, _, step = bfs(scan.cells, scan.blocked,
            function(cell) return regular_up(cell.feature) end)
        if step then
          d.return_waits = 0
          crawl.sendkeys(step)
          return true
        end
        -- Clouds and moving creatures can temporarily block every safe route.
        -- Teleportation can also strand us in a different connected component.
        -- After a bounded retry, abandon the survey and explore this floor.
        d.return_waits = (d.return_waits or 0) + 1
        if d.return_waits > 20 then
          d.phase = "normal"
          BOT.floor_done[here] = false
          BOT.floor_partial[here] = nil
          say("survey return unavailable; exploring current floor.")
          return false
        end
        crawl.do_commands({"CMD_WAIT"})
        return true
      end

    elseif d.phase == "child_up_travel" then
      if here == d.parent then
        d.index = d.index + 1
        d.phase = "survey_parent"
      elseif regular_up() then
        crawl.sendkeys("<")
        d.phase = "survey_returning"
        return true
      elseif d.child_up_tries < 2 then
        d.child_up_tries = d.child_up_tries + 1
        crawl.sendkeys("X<\r")
        return true
      else
        say("could not return to an upstairs after dipping -- paused.")
        d.phase = "paused"
        return true
      end

    elseif d.phase == "survey_returning" then
      if here == d.parent then
        d.index = d.index + 1
        d.phase = "survey_parent"
      else
        d.phase = "survey_child"
      end

    elseif d.phase == "commit_parent" then
      if d.commit_pos > #d.reachable then
        say("surveyed stairs became unreachable -- paused.")
        d.phase = "paused"
        return true
      end
      if at_down_index(d.reachable[d.commit_pos]) then
        d.phase = "commit_travel"
      elseif goto_down_index(d.reachable[d.commit_pos]) then
        return true
      else
        d.commit_pos = d.commit_pos + 1
      end

    elseif d.phase == "commit_travel" then
      if here ~= d.parent then
        BOT.committed_entry = {parent=d.parent, child=here,
          index=d.reachable[d.commit_pos]}
        d.phase = "normal"
        BOT.floor_done[here] = false
        BOT.floor_partial[here] = nil
        say("committed to " .. here .. "; beginning full exploration.")
        return false
      elseif regular_down() then
        crawl.sendkeys(">")
        d.phase = "commit_descending"
        return true
      else
        d.commit_pos = d.commit_pos + 1
        d.phase = "commit_parent"
      end

    elseif d.phase == "commit_descending" then
      if here ~= d.parent then
        BOT.committed_entry = {parent=d.parent, child=here,
          index=d.reachable[d.commit_pos]}
        d.phase = "normal"
        BOT.floor_done[here] = false
        BOT.floor_partial[here] = nil
        say("committed to " .. here .. "; beginning full exploration.")
        return false
      else
        d.commit_pos = d.commit_pos + 1
        d.phase = "commit_parent"
      end

    elseif d.phase == "paused" then
      return true
    else
      d.phase = "normal"
      return false
    end
  end

  say("state-machine guard tripped -- paused.")
  d.phase = "paused"
  return true
end

-- -------------------------------------------------------------------------
-- Message hook: floor-clear detection + blind-scroll resolution.
-- -------------------------------------------------------------------------

local ROUTE_BRANCHES = {
  D={key="D"}, Lair={key="L"}, Orc={key="O"}, Elf={key="E"},
  Swamp={key="S",rune="decaying"}, Shoals={key="A",rune="barnacled"},
  Snake={key="P",rune="serpentine"}, Spider={key="N",rune="gossamer"},
  Vaults={key="V",rune="silver"}, Depths={key="U"}, Zot={key="Z"},
}

local function route_observe(scan)
  if ROUTE_STATE.shopping and ROUTE_STATE.shopping.active then return end
  local branch,depth=you.branch(),you.depth()
  local target=ROUTE_STATE.target
  local previous=ROUTE_STATE.position
  if not ROUTE_STATE.recovery and target then
    local status=ROUTE_STATE.done[target.branch..":"..target.depth]
    local pending=status~="clear" and not (AUTOCrawl_ROUTE.allow_partial and status=="partial")
    local return_depth=target.branch==branch and target.depth
        or (BOT.route_shaft and previous and previous.branch==branch and previous.depth)
    if return_depth and depth>return_depth and
        ((target.branch==branch and pending) or
          (BOT.route_shaft and previous and previous.branch==branch and depth>previous.depth)) then
      ROUTE_STATE.recovery={branch=branch,depth=return_depth}
      say("route recovery: "..level_key().." -> "..branch..":"..return_depth)
    end
  end
  local recovery=ROUTE_STATE.recovery
  if recovery and branch==recovery.branch and depth<=recovery.depth then
    ROUTE_STATE.recovery=nil
    ROUTE_STATE.travel_attempts=0
    say("route recovery complete: "..level_key())
  end
  ROUTE_STATE.position={branch=branch,depth=depth}
  BOT.route_shaft=nil
  for _,cell in pairs(scan.cells) do
    -- Optional sealed vaults are not progression requirements. Keep native
    -- exploration outside their door/LOS fringe instead of oscillating there.
    if AUTOCrawl_ROUTE.skip_runed_vaults and cell.feature:find("runed",1,true)
        and not cell.excluded then
      travel.set_exclude(cell.x,cell.y,1)
    end
    for branch,_ in pairs(ROUTE_BRANCHES) do
      if cell.feature == "enter_" .. string.lower(branch) then
        ROUTE_STATE.entrances[branch] = level_key()
      end
    end
  end
end

local function route_resolve(branch)
  if ROUTE_BRANCHES[branch] then return branch end
  if ROUTE_STATE.choices[branch] then return ROUTE_STATE.choices[branch] end
  local alternatives = branch=="wet" and {"Swamp","Shoals"}
      or branch=="dry" and {"Snake","Spider"} or {}
  for _,name in ipairs(alternatives) do
    if ROUTE_STATE.entrances[name] or travel.find_deepest_explored(name)>0 then
      ROUTE_STATE.choices[branch]=name
      return name
    end
  end
end

local function route_block(reason)
  BOT.paused=true
  say("route blocked: " .. reason)
  if autocrawl_route_blocked then autocrawl_route_blocked(reason) end
  return true
end

local function route_exit_action(scan)
  if not ROUTE_STATE.return_exit then return false end
  if you.branch()~=ROUTE_STATE.return_exit then
    ROUTE_STATE.return_exit=nil; ROUTE_STATE.travel_attempts=0; return false
  end
  if scan.any or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  local function upstairs(f)
    return regular_up(f) or f=="exit_"..you.branch():lower()
  end
  if upstairs(feat_here()) then
    BOT.allow_route_exit=true
    crawl.sendkeys("<"); return true
  end
  local _,_,step=bfs(scan.cells,scan.blocked,function(c) return upstairs(c.feature) end)
  if step then crawl.sendkeys(step); return true end
  return false
end

local function escape_exclusion(scan)
  -- Exclusions are travel policy, not impassable terrain. When surrounded by
  -- them, find a short path back outside rather than asking G/o to escape.
  local ordinary_exit=false
  for _,delta in ipairs(MOVE_DELTAS) do
    ordinary_exit=ordinary_exit or can_step(scan.cells,0,0,delta[1],delta[2],scan.blocked)
  end
  if ordinary_exit then return false end
  local cells={}
  for key,cell in pairs(scan.cells) do
    cells[key]=cell
    if cell.excluded and cell.traversable and not cell.unsafe
        and not cell.feature:find("trap",1,true)
        and not cell.feature:find("runed",1,true)
        and cell.feature~="enter_shop" then
      local copy={}
      for k,v in pairs(cell) do copy[k]=v end
      copy.excluded=nil
      copy.bot_escape_exclusion=true
      cells[key]=copy
    end
  end
  local _,_,step=bfs(cells,scan.blocked,function(cell)
    return not cell.bot_escape_exclusion
  end)
  if step then
    say("leaving exclusion-surrounded square via safe terrain.")
    BOT.allow_exclusion_step=true
    crawl.sendkeys(step)
    return true
  end
  return false
end

local function route_recovery_action(scan)
  if not AUTOCrawl_ROUTE.enabled or not ROUTE_STATE.recovery then return false end
  -- Adjacent enemies must be handled by the encounter controller; never chase
  -- distant enemies on an accidentally reached floor. Survival/immobility gates
  -- run before this helper in ready(). Keep the route target frozen throughout.
  if you.confused() or (you.mesmerised and you.mesmerised())
      or scan.reachable_adjacent or BOT.disturbance_warning
      or (BOT.encounter and BOT.encounter.hidden_missing) then return false end
  if regular_up() then crawl.sendkeys("<"); return true end
  if not scan.any then
    local hp,mhp=you.hp()
    if hp<mhp or you.berserk() or berserk_recovering() then
      crawl.do_commands({"CMD_WAIT"}); return true
    end
  end
  local cells={}
  for key,cell in pairs(scan.cells) do
    if not cell.invisible_monster and not cell.feature:find("trap",1,true) then
      cells[key]=cell
    end
  end
  local _,_,step=bfs(cells,scan.blocked,function(c) return regular_up(c.feature) end)
  if step then crawl.sendkeys(step); return true end
  -- Discover upstairs one turn at a time: no native loot sweep, branch entry,
  -- downstairs fallback, or assumption that finding no frontier means cleared.
  local here=cells[map_key(0,0)]
  if here and here.frontier then
    for i,d in ipairs(MOVE_DELTAS) do
      if not scan.cells[map_key(d[1],d[2])] and view.can_reach(d[1],d[2])
          and (not view.is_safe_square or view.is_safe_square(d[1],d[2])) then
        crawl.sendkeys(MOVE_KEYS[i]); return true
      end
    end
  end
  local _,_,frontier=bfs(cells,scan.blocked,function(c) return c.frontier end)
  if frontier then crawl.sendkeys(frontier); return true end
  if scan.any then return false end
  return route_block("no safe upstairs or exploration frontier during recovery")
end

local route_started=false
local function required_entrance_action(scan)
  local target=ROUTE_STATE.target
  if not ROUTE_STATE.required_entrance or not target then return false end
  if you.branch()==target.branch then ROUTE_STATE.required_entrance=nil; return false end
  if scan.reachable_adjacent or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  local feature="enter_"..target.branch:lower()
  local goal
  for _,c in pairs(scan.cells) do if c.feature==feature then goal=c; break end end
  if not goal then ROUTE_STATE.required_entrance=nil; return false end
  if goal.x==0 and goal.y==0 then crawl.sendkeys(">"); return true end
  -- Only the required local entrance gets an exclusion override. Keep traps,
  -- sealed vaults, clouds and protected occupants off the path.
  local cells={}
  for key,c in pairs(scan.cells) do
    cells[key]=c
    if c.excluded and c.traversable and not c.unsafe and not c.cloud
        and not c.feature:find("trap",1,true) and not c.feature:find("runed",1,true) then
      local copy={}; for k,v in pairs(c) do copy[k]=v end
      copy.excluded=nil; copy.bot_escape_exclusion=true; cells[key]=copy
    end
  end
  local _,_,step=bfs(cells,scan.blocked,function(c) return c.feature==feature end)
  if step then
    say("required entrance: one-step approach to "..target.branch)
    BOT.allow_exclusion_step=true
    crawl.sendkeys(step); return true
  end
  return false
end

-- A disconnected arrival pocket can be "done exploring" without containing
-- any downstairs. Re-enter through another stair on the already-cleared parent.
local function route_pocket_action(scan)
  local p=ROUTE_STATE.pocket
  if not p then return false end
  if scan.any or you.confused() or movement_locked()
      or (you.mesmerised and you.mesmerised()) then return false end
  if you.branch()~=p.branch then return route_block("pocket recovery left branch") end
  local here=scan.cells["0:0"]
  if you.depth()==p.depth then
    for _,c in pairs(scan.cells) do
      if regular_down(c.feature) then
        ROUTE_STATE.pocket=nil; ROUTE_STATE.travel_attempts=0
        ROUTE_STATE.done[level_key()]=nil; BOT.floor_done[level_key()]=nil
        say("route pocket: downstairs discovered; resume exploration")
        if crawl.take_note then crawl.take_note("Route pocket: downstairs discovered") end
        return explore_frontier(scan,true)
      end
    end
    if p.reentered then
      p.reentered=nil
      ROUTE_STATE.done[level_key()]=nil; BOT.floor_done[level_key()]=nil
      return explore_frontier(scan,true)
    end
    if not ROUTE_STATE.done[level_key()] then return explore_frontier(scan,true) end
    if here and regular_up(here.feature) then
      if crawl.take_note then crawl.take_note("Route pocket: ascend "..here.feature) end
      crawl.sendkeys("<"); return true
    end
    local _,_,step=bfs(scan.cells,scan.blocked,function(c) return regular_up(c.feature) end)
    if step then crawl.sendkeys(step); return true end
    return route_block("pocket has no safe upstairs")
  elseif you.depth()==p.depth-1 then
    -- The arrival downstairs leads to the known dead-end pocket. Stair types
    -- identify the three normal stair sets; conservatively try each at most once.
    if not p.on_parent then
      p.on_parent=true
      if here and regular_down(here.feature) then p.tried[here.feature]=true end
    end
    if here and regular_down(here.feature) and not p.tried[here.feature] then
      p.tried[here.feature]=true; p.on_parent=nil; p.reentered=true
      say("route pocket: trying alternate downstairs")
      if crawl.take_note then crawl.take_note("Route pocket: alternate "..here.feature) end
      crawl.sendkeys(">"); return true
    end
    local _,_,step=bfs(scan.cells,scan.blocked,function(c)
      return regular_down(c.feature) and not p.tried[c.feature]
    end)
    if step then crawl.sendkeys(step); return true end
    return route_block("pocket recovery exhausted safe alternate stairs")
  end
  return route_block("pocket recovery unexpected depth")
end

-- Missing Lair is a search problem, not permission to skip the branch.
-- Two bounded passes over D8-11; start on the current candidate floor.
local function missing_lair_action(scan)
  if ROUTE_STATE.entrances.Lair or travel.find_deepest_explored("Lair")>0 then
    if ROUTE_STATE.entrance_search then crawl.take_note("Lair search: entrance found") end
    ROUTE_STATE.entrance_search=nil
    return false
  end
  if scan.any or you.confused() or movement_locked() then return false end
  local s=ROUTE_STATE.entrance_search
  if not s then
    local order={}
    if you.branch()=="D" and you.depth()>=8 and you.depth()<=11 then order[1]=you.depth() end
    for n=11,8,-1 do if n~=order[1] then order[#order+1]=n end end
    s={order=order,index=1,pass=1,started=you.turns(),travel_tries=0}
    ROUTE_STATE.entrance_search=s
    crawl.take_note("Lair search: revisiting D8-11")
  end
  if you.turns()-s.started>2000 then return route_block("Lair search exceeded 2000 turns") end
  local function advance()
    s.index=s.index+1; s.exploring=nil; s.cloud_wait=0; s.travel_tries=0
    if s.index>#s.order then s.index=1; s.pass=s.pass+1 end
    return missing_lair_action(scan)
  end
  if s.pass>2 then return route_block("Lair search exhausted two passes of D8-11") end
  local depth=s.order[s.index]
  if you.branch()~="D" or you.depth()~=depth then
    s.travel_tries=s.last_travel==you.turns() and s.travel_tries+1 or 0
    s.last_travel=you.turns()
    if s.travel_tries>=3 then return advance() end
    guarded_keys("GD"..depth.."\r"); return true
  end
  -- Clouds can temporarily hide a whole floor behind its arrival corridor.
  local cloud=false
  for _,c in pairs(scan.cells) do if c.visible and c.cloud then cloud=true end end
  if cloud then
    s.cloud_wait=(s.cloud_wait or 0)+1
    if s.cloud_wait>40 then return advance() end
    crawl.do_commands({"CMD_WAIT"}); return true
  end
  if not s.exploring then
    s.exploring=true
    ROUTE_STATE.done[level_key()]=nil
    BOT.floor_done[level_key()]=nil; BOT.floor_partial[level_key()]=nil
    crawl.take_note("Lair search: explore "..level_key().." pass "..s.pass)
  elseif ROUTE_STATE.done[level_key()] then return advance() end
  return explore_frontier(scan,true)
end

local function route_action(scan)
  if not AUTOCrawl_ROUTE.enabled then return false end
  -- A combat interruption must not let the isolated-enemy route shortcut
  -- start a competing progression trip while shopping still owns travel.
  if ROUTE_STATE.shopping and ROUTE_STATE.shopping.active then return false end
  if not route_started then
    ROUTE_STATE.travel_attempts=0
    ROUTE_STATE.last_travel_turn=nil
    route_started=true
  end
  route_observe(scan)
  if ROUTE_STATE.recovery then return route_recovery_action(scan) end
  if ROUTE_STATE.pocket then return route_pocket_action(scan) end
  if ROUTE_STATE.entrance_search and missing_lair_action(scan) then return true end
  -- The route owns progression; the legacy stair-dipping state machine must
  -- never descend beyond a stage boundary or compete with interbranch travel.
  BOT.dive={phase="normal"}
  for _=1,#AUTOCrawl_ROUTE.stages+1 do
    local stage=AUTOCrawl_ROUTE.stages[ROUTE_STATE.index]
    if not stage then
      BOT.paused=true
      ROUTE_STATE.complete=true
      say("ROUTE COMPLETE: Zot route explored; Orb run is not automated.")
      if autocrawl_route_complete then autocrawl_route_complete() end
      return true
    end
    local branch=route_resolve(stage.branch)
    if not branch then return route_block("undiscovered branch group "..stage.branch) end
    if ROUTE_STATE.announced~=ROUTE_STATE.index then
      ROUTE_STATE.announced=ROUTE_STATE.index
      say("route stage "..ROUTE_STATE.index..": "..branch..":"..stage.from.."-"..stage.to)
      if autocrawl_route_stage_enter then autocrawl_route_stage_enter(stage,branch) end
    end
    if stage.min_runes and you.num_runes()<stage.min_runes then
      return route_block(branch.." requires "..stage.min_runes.." runes")
    end
    local depth=nil
    for n=stage.from,stage.to do
      local status=ROUTE_STATE.done[branch..":"..n]
      if status~="clear" and not (AUTOCrawl_ROUTE.allow_partial and status=="partial") then
        depth=n
        break
      end
    end
    local rune=stage.rune and (type(stage.rune)=="string" and stage.rune or ROUTE_BRANCHES[branch].rune)
    if stage.rune and not rune then return route_block("no rune configured for "..branch) end
    if not depth and rune and not you.have_rune(rune) then
      return route_block(branch.." explored but "..rune.." rune not collected")
    end
    if not depth then
      say("route stage complete: "..branch..":"..stage.to)
      if autocrawl_route_stage_complete then autocrawl_route_stage_complete(stage,branch) end
      ROUTE_STATE.index=ROUTE_STATE.index+1
      ROUTE_STATE.travel_attempts=0
    else
      ROUTE_STATE.target={branch=branch,depth=depth}
      if route_exit_action(scan) then return true end
      if you.branch()==branch and you.depth()==depth then
        ROUTE_STATE.travel_attempts=0
        -- Branch floors are explored normally, including greedy rune pickup.
        if BOT.floor_partial[level_key()] then
          return explore_frontier(scan,false)
        end
        if visit_shop_action(scan) then return true end
        return explore_frontier(scan,true)
      end
      if branch~="D" and not ROUTE_STATE.entrances[branch]
          and travel.find_deepest_explored(branch)==0 then
        if branch=="Lair" then return missing_lair_action(scan) end
        return route_block("entrance to "..branch.." has not been discovered")
      end
      local turn=you.turns()
      ROUTE_STATE.travel_attempts = ROUTE_STATE.last_travel_turn==turn
          and (ROUTE_STATE.travel_attempts or 0)+1 or 0
      ROUTE_STATE.last_travel_turn=turn
      if ROUTE_STATE.travel_attempts>=3 then
        -- Interlevel travel can fail to connect a completed branch to an
        -- unexplored Dungeon target. Follow known upstairs to the parent
        -- branch first; retain the actual progression target throughout.
        if branch=="D" and you.branch()~="D" and not scan.any then
          if not ROUTE_STATE.return_exit and crawl.take_note then
            crawl.take_note("Route return: local upstairs toward Dungeon")
          end
          ROUTE_STATE.return_exit=you.branch()
          if route_exit_action(scan) then return true end
        end
        if branch==you.branch() and depth==you.depth()+1 and you.depth()>1
            and ROUTE_STATE.done[level_key()]=="clear"
            and (ROUTE_STATE.done[branch..":"..(you.depth()-1)]=="clear"
              or (AUTOCrawl_ROUTE.allow_partial
                and ROUTE_STATE.done[branch..":"..(you.depth()-1)]=="partial")) then
          local has_down=false
          for _,c in pairs(scan.cells) do if regular_down(c.feature) then has_down=true end end
          if not has_down then
            ROUTE_STATE.pocket={branch=branch,depth=you.depth(),tried={}}
            say("route pocket: return upstairs to find another entrance")
            if crawl.take_note then crawl.take_note("Route pocket: recovery started") end
            return route_pocket_action(scan)
          end
        end
        ROUTE_STATE.required_entrance=true
        if required_entrance_action(scan) then return true end
        if escape_exclusion(scan) then return true end
        for _,cell in pairs(scan.cells) do
          if cell.visible and cell.cloud then
            -- Harmless fog can hide every exit from an arrival pocket too.
            crawl.do_commands({"CMD_WAIT"})
            return true
          end
        end
        -- Teleports and newly reached arrival pockets can lack a cached
        -- interlevel path even though this floor was explored elsewhere.
        if ROUTE_STATE.travel_attempts>=6 then
          return route_block("travel to "..branch..":"..depth.." made no progress")
        end
        return explore_frontier(scan,true)
      end
      guarded_keys("G"..ROUTE_BRANCHES[branch].key..depth.."\r")
      return true
    end
  end
  return route_block("stage transition guard")
end

-- Character-local save hook, not rc-wide persistence shared between trials.
local function route_serialize(value)
  if type(value)=="table" then
    local out={"{"}
    for key,item in pairs(value) do
      out[#out+1]="["..route_serialize(key).."]="..route_serialize(item)..","
    end
    return table.concat(out).."}"
  elseif type(value)=="string" then return string.format("%q",value)
  elseif type(value)=="number" or type(value)=="boolean" then return tostring(value)
  end
  return "nil"
end
local previous_c_save=c_save
function c_save()
  local old=previous_c_save and previous_c_save() or ""
  return old.."\nROUTE_STATE="..route_serialize(ROUTE_STATE)
      .."\nAUTOCrawl_DEBUG_STATE="..route_serialize(AUTOCrawl_DEBUG_STATE).."\n"
      .."AUTOCrawl_WAND_STATE="..route_serialize(AUTOCrawl_WAND_STATE).."\n"
end

local previous_c_answer_prompt = c_answer_prompt
function c_answer_prompt(prompt)
  if tostring(prompt):lower():find("enter next level anyway",1,true)
      and BOT.allow_route_exit and BOT.route_exit_excluded then
    BOT.allow_route_exit=nil; BOT.route_exit_excluded=nil
    return true
  end
  if tostring(prompt):lower():find("are you sure you want to cancel this blink",1,true) then
    return true
  end
  if tostring(prompt):lower():find("really walk into a travel-excluded area",1,true)
      and BOT.allow_exclusion_step then
    BOT.allow_exclusion_step=nil
    return true
  end
  if tostring(prompt):lower():find("really explore while zot is near",1,true) then
    return true
  end
  if previous_c_answer_prompt then return previous_c_answer_prompt(prompt) end
  return nil
end

local previous_c_message = c_message
function c_message(text, channel)
  if BOT.allow_route_exit and tostring(text):lower():find(
      "this staircase leads to a travel-excluded area!",1,true) then
    BOT.route_exit_excluded=true
  end
  crawl.more_autoclear(true)
  if previous_c_message then previous_c_message(text, channel) end
  local s = string.lower(tostring(text or "")):gsub("<[^>]*>", "")
  if ROUTE_STATE.shopping and ROUTE_STATE.shopping.active
      and (s:find("don't know how to get there",1,true)
        or s:find("can't find a way",1,true)) then shop_abort("no route") end
  if s:find("really attack ",1,true) then
    -- Fail closed if a stale target or another command still reaches Crawl's
    -- protected-target confirmation. Never approve friendly fire.
    BOT.ally_attack_rejected=true
    crawl.sendkeys("n")
    return
  end
  if s:find("into a shaft and drop",1,true) then
    BOT.route_shaft=true
  end
  local e=BOT.encounter
  if e and e.hidden_caster and s:find("you kill "..e.hidden_caster.name:lower().."!",1,true) then
    e.hidden_caster=nil; e.hidden_missing=false
    BOT.disturbance_warning=false
  end
  if s:find("you kill the steam dragon!",1,true) then BOT.steam_target=nil end
  if s:find("are you sure you want to cancel this blink",1,true) then
    return
  end
  if s:find("the barbs in your skin will harm you if you move",1,true) then
    crawl.sendkeys("Y")
    return
  end

  -- The gear scorer has already selected this item. A warning inscription
  -- (including artefact drawbacks) must not leave its equip prompt unattended.
  if s:find("really equip ", 1, true) or s:find("really unwield ",1,true) then
    crawl.sendkeys("Y")
    return
  end

  if s:find("really walk into", 1, true) or s:find("really fly into", 1, true) then
    BOT.hazard_wait = true
    crawl.sendkeys("N")
    return
  end

  if s:find("keep equipping", 1, true) or s:find("keep disrobing", 1, true)
      or s:find("spend multiple turns changing equipment", 1, true) then
    crawl.sendkeys("N")
    return
  end

  if s == "blink to where?" then
    -- Blind-reading already queued Escape guards. Never append target keys:
    -- after cancellation those keys would become ordinary game commands.
    if not BOT.blind_pending then crawl.sendkeys("\027") end
    return
  end

  -- A rejected move consumes no turn. Remember when it failed, and leave
  -- unknown movement restrictions under manual control until time advances.
  -- Never enqueue another command from this message callback.
  if s:find("you cannot move away from", 1, true)
      or s:find("you cannot move closer to", 1, true) then
    BOT.directional_rejected_at = you.turns()
  elseif s:find("you cannot move", 1, true)
      or s:find("you can't move", 1, true)
      or s:find("because you cannot move", 1, true) then
    BOT.move_rejected_at = you.turns()
    BOT.move_rejected_reason = "unknown"
  end

  -- Handle the level-up prompt without requiring a human keypress.
  if s:find("increase (s)trength", 1, true) then
    crawl.sendkeys("S")
    return
  end

  -- Autoexplore/autofight can report a nearby or unreachable monster without
  -- consuming a turn.  Defer a one-step BFS decision to ready() so the
  -- controller cannot spin on the same no-op command.
  if s:find("is nearby!", 1, true)
      or s:find("there are monsters nearby", 1, true)
      or s:find("no reachable target in view", 1, true) then
    BOT.noop_warning = true
  end
  if s:find("no target in view", 1, true)
      or s:find("no target in range", 1, true)
      or s:find("failed to move towards target", 1, true)
      or s:find("no reachable target in view", 1, true) then
    BOT.autofight_rejected = true
  end

  if s:find("strange disturbance", 1, true)
      or s:find("something hits you", 1, true)
      or s:find("something tries to affect you", 1, true)
      or s:find("strange, mumbled words", 1, true) then
    if not BOT.disturbance_warning then BOT.disturbance_turns = 0 end
    BOT.disturbance_warning = true
    BOT.disturbance_last_seen = you.turns()
  end

  if s == "done exploring." then
    BOT.floor_done[level_key()] = true
    BOT.floor_partial[level_key()] = nil
    if AUTOCrawl_ROUTE.enabled then ROUTE_STATE.done[level_key()]="clear" end
  elseif s:find("partly explored", 1, true) then
    BOT.floor_done[level_key()] = false
    BOT.floor_partial[level_key()] = true
    BOT.partial_reason[level_key()] = s
    if AUTOCrawl_ROUTE.enabled and (s:find("can't reach some",1,true)
        or s:find("unopened runed door",1,true)
        or s=="partly explored, unvisited transporter.") then
      ROUTE_STATE.done[level_key()]="partial"
    end
  end

  if BOT.blind_pending then
    if s:find("scroll of identify", 1, true) then
      BOT.blind_pending = false
      BOT.blind_target = nil
    elseif s:find("scroll of teleportation", 1, true)
        or s:find("scroll of torment", 1, true) then
      BOT.blind_pending = false
      BOT.blind_target = nil
      BOT.escape_after_blind = true
    elseif s:find("it is a scroll of", 1, true)
        or s:find("it was a scroll of", 1, true) then
      BOT.blind_pending = false
      BOT.blind_target = nil
    end
  end
end

-- -------------------------------------------------------------------------
-- Main turn hook.
-- -------------------------------------------------------------------------

local function check_committed_return()
  -- Returning from a committed child without completing it must not select
  -- that same failed arrival repeatedly. Stair order is translation-invariant.
  local entry = BOT.committed_entry
  if entry and level_key() == entry.parent and BOT.dive.phase == "normal" then
    BOT.failed_entries[entry.parent] = BOT.failed_entries[entry.parent] or {}
    BOT.failed_entries[entry.parent][entry.index] = true
    BOT.committed_entry = nil
    say("returned from blocked entry; trying another staircase.")
  end
end

-- Emergency banishment mode: exits, movement and escape resources, not a
-- normal floor-clear/combat stage. Replan against the shifting map each turn.
local function abyss_action(scan)
  if you.branch()~="Abyss" then
    if BOT.abyss then
      crawl.take_note("Abyss escape mode: returned to "..level_key())
      BOT.abyss=nil; BOT.encounter=nil; BOT.recovery_anchor=nil
    end
    return false
  end
  local a=BOT.abyss
  if not a then
    a={dx=1,dy=1,last_resource=-1000}; BOT.abyss=a
    shop_abort("banishment")
    crawl.take_note("Abyss escape mode: arrived "..level_key().." HP="..you.hp())
  end
  local here=scan.cells["0:0"]
  if here and here.feature=="exit_abyss" then
    crawl.take_note("Abyss escape mode: taking exit")
    crawl.sendkeys(">"); return true
  end
  if you.confused() then
    if use_known_consumable("potion","curing") then return true end
    if not confused_combat_action(scan) then crawl.do_commands({"CMD_WAIT"}) end
    return true
  end
  local _,_,exit_step=bfs(scan.cells,scan.blocked,function(c) return c.feature=="exit_abyss" end)
  if exit_step and not movement_locked() then
    if not a.exit_seen then crawl.take_note("Abyss escape mode: approaching known exit"); a.exit_seen=true end
    crawl.sendkeys(exit_step); return true
  end
  a.exit_seen=nil
  local hp=hp_percent()
  if hp<55 and use_known_consumable("potion","heal wounds") then return true end
  if (you.poisoned() or hp<20) and use_known_consumable("potion","curing") then return true end
  if scan.any and (hp<70 or #scan.monsters>=3) and not you.status("about to teleport")
      and use_known_consumable("scroll","teleportation") then return true end
  if scan.any and you.turns()-a.last_resource>=10 then
    if (hp<70 and not you.status("invisible") and use_known_consumable("potion","invisibility"))
        or (scan.reachable_adjacent and use_known_consumable("scroll","fear"))
        or (hp<80 and use_known_consumable("scroll","fog")) then
      a.last_resource=you.turns(); return true
    end
  end
  if movement_locked() then crawl.do_commands({"CMD_WAIT"}); return true end
  local function danger(x,y)
    local cost=0
    for _,m in ipairs(scan.monsters) do
      local dist=math.max(math.abs(m.x-x),math.abs(m.y-y))
      cost=cost+(dist<=1 and 40 or 12/math.max(1,dist))
    end
    return cost
  end
  -- Head toward reachable unexplored edges, preferring steps away from enemies.
  -- A persistent heading breaks symmetric back-and-forth movement choices.
  local best,score
  for i,d in ipairs(MOVE_DELTAS) do
    local key=MOVE_KEYS[i]
    if can_step(scan.cells,0,0,d[1],d[2],scan.blocked) then
      local value=d[1]*a.dx+d[2]*a.dy-danger(d[1],d[2])
      for pos,c in pairs(scan.cells) do
        if c.frontier and scan.first_step[pos]==key then
          value=value+8+1/(1+math.abs(c.x)+math.abs(c.y)); break
        end
      end
      if not score or value>score then best,score=i,value end
    end
  end
  -- Keep walking unless it cannot create separation at low HP.
  if (not best or (scan.reachable_adjacent and hp<65)) and not you.berserk()
      and not you.silenced() and a.last_blink~=you.turns() then
    local target,value
    for _,c in pairs(scan.cells) do
      local dist=math.max(math.abs(c.x),math.abs(c.y))
      if c.visible and c.traversable and not c.unsafe and not c.cloud
          and not c.monster and not c.invisible_monster and dist>=3 and dist<=7
          and view.is_safe_square(c.x,c.y) then
        local v=dist-danger(c.x,c.y)
        if not value or v>value then target,value=c,v end
      end
    end
    if target and danger(target.x,target.y)<danger(0,0) then
      for _,it in ipairs(items.inventory()) do
        if item_class(it)=="scroll" and it.is_identified and item_name(it):find("blinking",1,true) then
          a.last_blink=you.turns()
          local aim=string.rep(target.x<0 and "h" or "l",math.abs(target.x))
              ..string.rep(target.y<0 and "k" or "j",math.abs(target.y))
          guarded_keys("r"..inv_letter(it).."r"..aim.."f")
          if turn_spent(a.last_blink) then
            crawl.take_note("Abyss escape mode: emergency blink")
            return true
          end
          break
        end
      end
    end
  end
  if best then
    local d=MOVE_DELTAS[best]; a.dx,a.dy=d[1],d[2]
    crawl.sendkeys(MOVE_KEYS[best]); return true
  end
  -- Boxed in: attack only an adjacent blocker, never Tab-pursue or berserk.
  for _,m in ipairs(scan.monsters) do
    local cmd=CONFUSED_MOVE_COMMANDS[map_key(m.x,m.y)]
    if cmd then crawl.do_commands({(cmd:gsub("CMD_MOVE_","CMD_ATTACK_"))}); return true end
  end
  crawl.do_commands({"CMD_WAIT"}); return true
end

function ready()
  -- This rc is intentionally a MiBe-only controller.
  if you.species() ~= "Minotaur" or you.class() ~= "Berserker" then return end

  -- The game resets this flag whenever control returns to the player.
  crawl.more_autoclear(true)
  BOT.allow_exclusion_step=nil
  BOT.allow_route_exit=nil; BOT.route_exit_excluded=nil
  if AUTOCrawl_DEBUG_STATE.stop_turn and you.turns()>=AUTOCrawl_DEBUG_STATE.stop_turn then
    AUTOCrawl_DEBUG_STATE.stop_turn=nil
    AUTOCrawl_DEBUG_STATE.paused=true
    say("DEBUG PAUSE: bounded encounter test complete")
  end
  if BOT.paused or AUTOCrawl_DEBUG_STATE.paused then return end
  check_committed_return()
  if BOT.hazard_wait and not you.status("liquid fire") and not you.status("on fire") then
    BOT.hazard_wait = false
    crawl.do_commands({"CMD_WAIT"})
    return
  end

  if BOT.move_rejected_at and BOT.move_rejected_at ~= you.turns() then
    BOT.move_rejected_at = nil
    BOT.move_rejected_reason = nil
    BOT.move_rejected_announced = false
  end
  -- Migrate the old unclassified latch when hotloading into an enthralled
  -- character. Newly observed unknown restrictions still retain the safe pause.
  if BOT.move_rejected_at and not BOT.move_rejected_reason
      and you.mesmerised and you.mesmerised() then
    BOT.move_rejected_at = nil
    BOT.move_rejected_announced = false
    BOT.directional_rejected_at = you.turns()
  end
  if BOT.move_rejected_at and not movement_locked() then
    if not BOT.move_rejected_announced then
      say("movement rejected -- paused until a manual turn advances.")
      BOT.move_rejected_announced = true
    end
    return
  end

  local scan = scan_hostiles()
  if abyss_action(scan) then return end
  if debug_encounter_pause(scan) then return end
  observe_recovery_anchor(scan)
  observe_steam_dragon(scan)
  if AUTOCrawl_ROUTE.enabled then
    -- Route observation is bookkeeping; encounter decisions remain above travel.
    route_observe(scan)
    BOT.dive={phase="normal"}
  end
  observe_encounter(scan)
  if ROUTE_STATE.shopping and ROUTE_STATE.shopping.active then
    if (BOT.encounter and BOT.encounter.phase=="disengage") or BOT.disturbance_warning
        or you.confused() then shop_abort("retreat or uncertain threat") end
  end
  observe_wand_encounter(scan)
  if BOT.ally_attack_rejected then
    BOT.ally_attack_rejected=false
    crawl.do_commands({"CMD_WAIT"}); return
  end
  if liquid_fire_action(scan) then return end
  if survival_action(scan) then return end
  if combat_wand_action(scan) then return end
  if sigmund_action(scan) then return end
  -- Central gate covers combat pursuit, confusion, exploration, shops and
  -- stair travel. Adjacent melee remains available when not confused.
  if movement_locked() then
    if scan.any and (you.confused() or not scan.reachable_adjacent) then
      if not BOT.immobile_announced then
        say("immobile with enemies outside usable melee -- automation paused.")
        BOT.immobile_announced = true
      end
      return
    end
    BOT.immobile_announced = false
    if scan.any then encounter_action(scan)
    else crawl.do_commands({"CMD_WAIT"}) end
    return
  end
  BOT.immobile_announced = false

  -- Entering a shop is forbidden while berserk and must not preempt combat.
  -- A rejected '<' spends no turn and otherwise loops forever on this tile.
  if feat_here() == "enter_shop" and not you.berserk() and not scan.any then
    if scan.cells[map_key(0,0)] and scan.cells[map_key(0,0)].unvisited then
      -- '<' ENTERS a shop. Visit once to register its stock, then close the
      -- menu with Escape. Never reopen it on every ready() at the same tile.
      guarded_keys("<")
      shop_catalogue()
      return
    end
  end

  if you.confused() and confused_combat_action(scan) then return end
  if not you.confused() then BOT.confused_announced = false end
  if mesmerised_action(scan) then return end
  if BOT.directional_rejected_at == you.turns() then
    crawl.do_commands({"CMD_WAIT"}); return
  end
  if AUTOCrawl_TACTICS.steam_charge then
    for _,enemy in ipairs(scan.monsters) do
      if enemy.monster and enemy.monster.name and enemy.monster:name()=="steam dragon"
          and math.max(math.abs(enemy.x),math.abs(enemy.y))==1 and enemy.reachable then
        BOT.autofight_rejected=false
        encounter_action(scan); return
      end
    end
  end
  if steam_charge_action(scan) then return end
  if required_entrance_action(scan) then return end
  if approach_action(scan) then return end
  if not scan.reachable_adjacent and escape_exclusion(scan) then return end
  if not scan.reachable_adjacent and unsafe_square_action(scan) then return end
  if isolated_recovery_action(scan) then return end
  if route_recovery_action(scan) then return end
  if throwing_action(scan) then return end
  if manage_encounter(scan) then return end

  -- Invisible or otherwise unclassified activity cannot be resolved by the
  -- visible-monster scanner.  Probe adjacent squares instead of resting into
  -- a safe-wait no-op or walking blindly into the disturbance.
  if (BOT.disturbance_warning or (BOT.encounter and BOT.encounter.hidden_missing)) and not scan.any then
    if not BOT.disturbance_announced then
      say("unseen disturbance -- probing adjacent squares.")
      BOT.disturbance_announced = true
    end

    local cmd
    local approach
    for _, cell in pairs(scan.cells) do
      local distance=math.max(math.abs(cell.x), math.abs(cell.y))
      local m=cell.monster
      local unprotected=not m or (m.attitude and m:attitude()==0)
      if unprotected and cell.invisible_monster and distance == 1 then
        local move = CONFUSED_MOVE_COMMANDS[map_key(cell.x, cell.y)]
        cmd = move and move:gsub("CMD_MOVE_", "CMD_ATTACK_")
        break
      elseif unprotected and cell.invisible_monster and distance==2 and not movement_locked()
          and not (you.mesmerised and you.mesmerised()) then
        approach=scan.first_step[map_key(cell.x,cell.y)]
      end
    end
    if not cmd and approach then
      say("unseen threat: closing to marked disturbance")
      crawl.sendkeys(approach); return
    end
    if not cmd and BOT.disturbance_turns>=AUTOCrawl_TACTICS.blind_probe_limit
        and ((BOT.encounter and BOT.encounter.hidden_missing)
          or you.turns()-(BOT.disturbance_last_seen or -10000)<8) then
      -- Stop blind direction cycling. Try a known upstairs route, never an
      -- unexplored tile, and keep a finite movement budget for this encounter.
      local e=BOT.encounter
      if e and not you.berserk() and not berserk_recovering()
          and not you.confused() and not movement_locked()
          and not (you.mesmerised and you.mesmerised())
          and e.retreats<AUTOCrawl_TACTICS.retreat_moves then
        if regular_up() then crawl.sendkeys("<"); return end
        local best,dist=nil,10000
        for key,c in pairs(scan.cells) do
          if regular_up(c.feature) and scan.first_step[key] then
            local d=math.abs(c.x)+math.abs(c.y)
            if d<dist then best,dist=scan.first_step[key],d end
          end
        end
        if best then
          e.retreats=e.retreats+1
          say("unseen threat: withdrawing toward known upstairs")
          crawl.sendkeys(best); return
        end
      end
      -- No justified attack direction or usable retreat: consume one turn and
      -- recheck emergency resources. Never invent a target from stale coordinates.
      crawl.do_commands({"CMD_WAIT"}); return
    elseif not cmd and not (BOT.encounter and BOT.encounter.hidden_missing)
        and you.turns() - (BOT.disturbance_last_seen or you.turns()) >= 8 then
      BOT.disturbance_warning = false
      BOT.disturbance_announced = false
      BOT.disturbance_turns = 0
    else
      local turn = you.turns()
      cmd = safe_probe_command(scan,cmd)
      BOT.disturbance_turns = BOT.disturbance_turns + 1
      crawl.do_commands({cmd})
      -- Only wait if the attack was rejected and did not spend a turn.
      if not turn_spent(turn) then
        crawl.do_commands({"CMD_WAIT"})
      end
      return
    end
  end
  if scan.any then
    if not (BOT.encounter and BOT.encounter.hidden_missing) then BOT.disturbance_warning = false end
    BOT.disturbance_announced = false
    BOT.disturbance_turns = 0
  end

  if BOT.noop_warning then
    BOT.noop_warning = false
    if not scan.any and not (AUTOCrawl_ROUTE.enabled
        and ROUTE_STATE.done[level_key()]) then
      explore_frontier(scan, false)
      return
    end
  end

  -- An isolated monster must not strand a stair survey in the child pocket.
  -- The survey already knows how to return via the arrival stair.
  if BOT.dive.phase ~= "normal" and not scan.reachable_any then
    if dive_action() then return end
  end
  local completion=ROUTE_STATE.done[level_key()]
  if AUTOCrawl_ROUTE.enabled and scan.any and not scan.reachable_any
      and (completion=="clear" or
          (completion=="partial" and AUTOCrawl_ROUTE.allow_partial)) then
    if route_action(scan) then return end
  end
  if encounter_action(scan) then return end
  if unsafe_square_action(scan) then return end

  if not AUTOCrawl_ROUTE.enabled and BOT.floor_partial[level_key()] then
    local frontier, onward = false, false
    for key, cell in pairs(scan.cells) do
      if scan.seen[key] then
        frontier = frontier or cell.frontier
        onward = onward or regular_down(cell.feature)
      end
    end
    if frontier then
      explore_frontier(scan, false)
      return
    end
    -- Native exploration exhausted this connected area. Do not confuse
    -- inaccessible terrain with reachable unfinished exploration. Keep the
    -- partial flag, and never count this as a full D:15 clear.
    if BOT.partial_reason[level_key()] == "partly explored, can't reach some places."
        and not frontier and onward and you.depth() < 15 then
      say("accessible area explored; inaccessible places remain -- surveying onward.")
      start_dive_survey()
      dive_action()
      return
    end
    -- Leave an inaccessible arrival pocket via upstairs, then try another
    -- surveyed entry. Never call this floor complete or descend from it.
    if regular_up() then crawl.sendkeys("<"); return end
    local _, _, retreat = bfs(scan.cells, scan.blocked,
        function(cell) return regular_up(cell.feature) end)
    if retreat then crawl.sendkeys(retreat); return end
    BOT.paused = true
    say("exploration incomplete with no upstairs route -- paused.")
    return
  end

  -- If blind-reading produced torment/teleportation, leave immediately.
  if BOT.escape_after_blind and regular_up() then
    BOT.escape_after_blind = false
    crawl.sendkeys("<")
    return
  end

  -- No visible enemies: wait out berserk/slow/exhaustion and heal fully.
  local hp, mhp = you.hp()
  if you.berserk() or berserk_recovering() or hp < mhp then
    -- CMD_SAFE_WAIT (`5`) refuses to advance when Crawl reports an unseen
    -- disturbance, which can re-enter ready() forever.  CMD_WAIT is a real
    -- one-turn wait; visible threats were already handled above.
    crawl.do_commands({"CMD_WAIT"})
    return
  end

  update_skills()

  -- During a stair-dip, returning safely takes precedence over shopping/ID.
  if BOT.dive.phase ~= "normal" then
    if dive_action() then return end
  end

  -- Re-equip only while healthy and with no visible enemies.
  if auto_equip_action() then return end
  if drop_redundant_gear() then return end

  -- Stair-based ID routine.
  if auto_id_action() then return end
  if shopping_action(scan) then return end
  if route_action(scan) then return end

  -- Start the survey only after autoexplore reports this floor exhausted.
  if BOT.floor_done[level_key()] then
    if you.branch() == "D" and you.depth() == 15 then
      BOT.paused = true
      BOT.success = true
      say("SUCCESS: D:15 exploration complete -- trial finished.")
      return
    end
    BOT.floor_done[level_key()] = false
    start_dive_survey()
    if dive_action() then return end
  end

  -- Native exploration handles ordinary travel and floor loot; custom BFS
  -- remains the fallback for monster/no-op interruptions.
  if visit_shop_action(scan) then return end
  explore_frontier(scan, true)
end

-- Opt-in diagnosis only: pause before the D:6 steam dragon, then authorize
-- exactly one ready() decision per console request (including no-turn actions).
if AUTOCrawl_TACTICS.steam_debug then
  AUTOCrawl_STEAM_TRACE = {started=false, permit=false, lines={}, n=0}
  local t=AUTOCrawl_STEAM_TRACE
  local function log(s)
    if AUTOCrawl_TACTICS.steam_debug_entry then crawl.take_note("TRACE "..s)
    else t.lines[#t.lines+1]=s end
  end
  local function tracing()
    return t.started and (not AUTOCrawl_TACTICS.steam_debug_entry or level_key()=="D:6")
  end
  if AUTOCrawl_TACTICS.steam_debug_entry then
    local previous=c_message
    function c_message(s,c)
      previous(s,c)
      if tracing() and c~="prompt" and not s:find("TRACE ",1,true)
          and not s:find("<cyan>",1,true) and not s:find("exit interpreter",1,true) then
        crawl.take_note("EVENT "..s)
      end
    end
  end
  local function wrap(name,fn)
    return function(...)
      local result=fn(...)
      if tracing() and result then log("selected "..name) end
      return result
    end
  end
  survival_action=wrap("survival",survival_action)
  combat_wand_action=wrap("wand",combat_wand_action)
  manage_encounter=wrap("encounter",manage_encounter)
  unsafe_square_action=wrap("leave unsafe square",unsafe_square_action)
  rejected_autofight_action=wrap("rejected autofight fallback",rejected_autofight_action)
  isolated_enemy_action=wrap("isolated enemy",isolated_enemy_action)
  explore_frontier=wrap("exploration",explore_frontier)
  for _,name in ipairs({"sendkeys","do_commands","process_keys"}) do
    local original=crawl[name]
    crawl[name]=function(value,...)
      if tracing() then
        local s=type(value)=="table" and table.concat(value,",") or tostring(value)
        log(name.." "..s:gsub("\027","<ESC>"):gsub("\t","<TAB>"))
      end
      return original(value,...)
    end
  end
  local function snapshot()
    local scan=scan_hostiles()
    local e=BOT.encounter or {}
    log("turn="..you.turns().." HP="..you.hp().."/"..select(2,you.hp())
      .." level="..level_key().." pos="..(you.x_pos and you.x_pos() or "unavailable")
      ..","..(you.y_pos and you.y_pos() or "unavailable")
      .." feat="..feat_here().." phase="..tostring(e.phase)
      .." retreats="..tostring(e.retreats).." hidden="..tostring(e.hidden_missing)
      .." unseen="..tostring(e.unseen).." disturbance="..tostring(BOT.disturbance_warning)
      .." probes="..tostring(BOT.disturbance_turns).." rejected="..tostring(BOT.autofight_rejected)
      .." rage="..tostring(you.berserk()).." cooldown="..tostring(berserk_recovering())
      .." confused="..tostring(you.confused()))
    for _,m in ipairs(scan.monsters) do
      log("enemy "..m.monster:name().." "..m.x..","..m.y.." threat="..m.threat
        .." reachable="..tostring(m.reachable))
    end
    for _,d in ipairs(MOVE_DELTAS) do
      local c=scan.cells[map_key(d[1],d[2])]
      log("tile "..d[1]..","..d[2].." "..(c and c.feature or "unknown")
        .." cloud="..tostring(c and c.cloud).." safe="..tostring(view.is_safe_square(d[1],d[2]))
        .." step="..tostring(can_step(scan.cells,0,0,d[1],d[2],scan.blocked)))
    end
  end
  function autocrawl_steam_report()
    snapshot()
    for _,s in ipairs(t.lines) do crawl.mpr("TRACE "..s) end
    t.lines={}
  end
  function autocrawl_steam_step() t.permit=true end
  local function roster()
    local out={}
    for _,m in ipairs(scan_hostiles().monsters) do
      local name=m.monster:name(); out[name]=(out[name] or 0)+1
    end
    return out
  end
  function autocrawl_steam_run(n)
    t.budget=math.min(tonumber(n) or 1,500); t.roster=roster()
  end
  local original_ready=ready
  function ready()
    if AUTOCrawl_TACTICS.steam_debug_entry and level_key()~="D:6" then
      original_ready(); return
    end
    if not t.started and level_key()=="D:6" then
      if AUTOCrawl_TACTICS.steam_debug_entry then
        t.started=true; snapshot()
        say("DEBUG PAUSE: first D:6 arrival")
        return
      end
      for _,m in ipairs(scan_hostiles().monsters) do
        if m.monster:name()=="steam dragon" then
          t.started=true
          say("DEBUG PAUSE: D:6 steam dragon; use autocrawl_steam_step()")
          return
        end
      end
    end
    if t.started then
      if t.budget and t.budget>0 then
        local now=roster()
        for name,count in pairs(now) do
          if count>(t.roster[name] or 0) then
            t.budget=0; snapshot(); say("DEBUG PAUSE: new contact "..name); return
          end
        end
        t.roster=now; t.budget=t.budget-1; t.permit=true
      end
      if not t.permit then return end
      t.permit=false; t.n=t.n+1
      log("DECISION "..t.n); snapshot()
    end
    original_ready()
  end
end

>
