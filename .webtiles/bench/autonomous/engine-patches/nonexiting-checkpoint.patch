 // Saves the game without exiting.
+// Laboratory decision-boundary snapshot. Unlike the normal autosave, include
+// the current level; unlike save-and-quit, leave the package and game running.
+void save_tactical_checkpoint()
+{
+    unwind_bool saving_game(crawl_state.saving_game, true);
+    ASSERT(you.on_current_level && !you.entering_level && you.save);
+    _save_game_base();
+    save_level(level_id::current());
+    you.save->commit();
+}
+
+// Saves the game without exiting.
 void save_game_state()
 {
     save_game(false);
