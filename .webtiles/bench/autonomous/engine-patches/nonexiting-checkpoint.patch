 // Opt-in local laboratory transport. Evaluate observation under the same RNG
+static int crawl_tactical_checkpoint(lua_State *ls)
+{
+    const char *path = getenv("DCSS_TACTICAL_OBSERVATION_FIFO");
+    if (!path || !*path || !tactical_sim_ready || !you.save
+        || !you.on_current_level || you.entering_level || you.turn_is_over
+        || Options.no_save)
+        return luaL_error(ls, "Checkpoint requires a laboratory decision boundary");
+    save_tactical_checkpoint();
+    return 0;
+}
+
+// Exact diagnostic states, as strings to avoid Lua double precision loss.
+// UI RNG is deliberately excluded: greetings/rendering may advance it on load.
+static int crawl_tactical_rng_state(lua_State *ls)
+{
+    const char *path = getenv("DCSS_TACTICAL_OBSERVATION_FIFO");
+    if (!path || !*path)
+        return luaL_error(ls, "RNG diagnostics require laboratory transport");
+    if (!getenv("DCSS_GENERAL_RNG_DIAGNOSTICS"))
+        return 0; // Do not put privileged RNG state in ordinary policy replay.
+    lua_newtable(ls);
+    for (int i = 0; i < rng::NUM_RNGS; ++i)
+    {
+        if (i == rng::UI)
+            continue;
+        // get_generator() currently resolves the active domain, not its
+        // argument. Select explicitly without drawing from any generator.
+        rng::generator selected(static_cast<rng::rng_type>(i));
+        auto *generator = rng::get_generator(static_cast<rng::rng_type>(i));
+        const string value = make_stringf("%016llx:%016llx",
+            static_cast<unsigned long long>(generator->get_state()),
+            static_cast<unsigned long long>(generator->get_inc()));
+        lua_pushstring(ls, value.c_str());
+        lua_rawseti(ls, -2, i + 1);
+    }
+    return 1;
+}
