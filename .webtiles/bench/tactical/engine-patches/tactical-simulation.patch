diff --git a/crawl-ref/source/tactical-sim.h b/crawl-ref/source/tactical-sim.h
new file mode 100644
index 0000000..c30c6b0
--- /dev/null
+++ b/crawl-ref/source/tactical-sim.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdlib>
+
+// Local benchmark only. Activate after the first structured decision boundary,
+// so startup menus remain usable. Bit 1 suppresses delays; bit 2 presentation.
+extern bool tactical_sim_ready;
+inline bool tactical_sim_enabled(int bit)
+{
+    static const int flags = getenv("DCSS_TACTICAL_SIM_FLAGS")
+        ? atoi(getenv("DCSS_TACTICAL_SIM_FLAGS")) : 0;
+    return tactical_sim_ready && (flags & bit);
+}
