+// Opt-in local laboratory transport. Evaluate observation under the same RNG
+// domain as dump_char; inspecting equipment must not consume gameplay rolls.
+static int crawl_tactical_emit(lua_State *ls)
+{
+#ifndef TARGET_OS_WINDOWS
+    const char *path = getenv("DCSS_TACTICAL_OBSERVATION_FIFO");
+    if (!path || !*path)
+        return luaL_error(ls, "Tactical observation FIFO is not configured");
+    tactical_sim_ready = true;
+    luaL_checktype(ls, 1, LUA_TFUNCTION);
+    lua_pushvalue(ls, 1);
+    int status;
+    {
+        rng::generator ui(rng::UI);
+        status = lua_pcall(ls, 0, 1, 0);
+    }
+    if (status)
+        return lua_error(ls);
+    size_t size;
+    const char *data = luaL_checklstring(ls, -1, &size);
+    const int fd = open(path, O_WRONLY | O_NOFOLLOW);
+    if (fd < 0)
+        return luaL_error(ls, "Cannot open tactical FIFO");
+    struct stat info;
+    if (fstat(fd, &info) || !S_ISFIFO(info.st_mode))
+    {
+        close(fd);
+        return luaL_error(ls, "Tactical output must be a FIFO");
+    }
+    size_t sent = 0;
+    while (sent < size)
+    {
+        const ssize_t n = write(fd, data + sent, size - sent);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            break;
+        sent += n;
+    }
+    close(fd);
+    if (sent != size)
+        return luaL_error(ls, "Incomplete tactical observation");
+    return 0;
+#else
+    return luaL_error(ls, "Tactical FIFO transport requires Unix");
+#endif
+}
