+static void _general_record_reveal(const coord_def c)
+{
+    static const bool enabled = getenv("DCSS_EXPLORATION_SCORE")
+        && string(getenv("DCSS_EXPLORATION_SCORE")) == "1";
+    if (!enabled || !map_bounds(c))
+        return;
+    // Player props are saved exactly, independent of forgetting or map reset.
+    // One lifetime bucket per branch/depth also bounds regenerated Pan/Abyss/Zig.
+    auto &levels = you.props["general_exploration_v1"].get_table();
+    auto &record = levels[level_id::current().describe()].get_table();
+    if (!record.exists("tiles"))
+    {
+        string eligible(GXM * GYM, '0');
+        int total = 0;
+        for (rectangle_iterator ri(BOUNDARY_BORDER - 1); ri; ++ri)
+        {
+            const auto feat = env.grid(*ri);
+            if (map_bounds(*ri) && (!feat_is_solid(feat) || feat_is_closed_door(feat)))
+            {
+                eligible[ri->x + GXM * ri->y] = '1';
+                ++total;
+            }
+        }
+        record["tiles"] = eligible;
+        record["total"] = total;
+        record["revealed"] = 0;
+        record["depth"] = max(1, you.where_are_you == BRANCH_DUNGEON
+            ? you.depth : branches[you.where_are_you].absdepth + you.depth - 1);
+    }
+    auto &tiles = record["tiles"].get_string();
+    char &tile = tiles[c.x + GXM * c.y];
+    if (tile == '1')
+    {
+        tile = '2';
+        ++record["revealed"].get_int();
+    }
+}
+
+double general_exploration_credit()
+{
+    if (!you.props.exists("general_exploration_v1"))
+        return 0.;
+    double credit = 0.;
+    const auto &levels = you.props["general_exploration_v1"].get_table();
+    for (const auto &entry : levels)
+    {
+        const auto &record = entry.second.get_table();
+        const int total = record["total"].get_int();
+        if (total > 0)
+            credit += 100. * record["depth"].get_int()
+                * record["revealed"].get_int() / total;
+    }
+    return credit;
+}
