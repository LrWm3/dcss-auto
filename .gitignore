# Local Crawl checkout: reproduce it from engine/ rather than vendoring binaries.
/crawl-0.35/

# Python environments and generated bytecode.
.build-venv/
.rl-venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Simulator state, learned weights and bulk trajectories stay local.
/.webtiles/bench/autonomous/artifacts/
/.webtiles/bench/tactical/artifacts/
/.webtiles/bench/batches/
/.webtiles/bench/maintenance/*.jsonl
/.webtiles/running/
/.webtiles/sockets/
/.webtiles/ttyrecs/
*.cs
*.cs.bak
*.pt
*.pth
*.ttyrec

# Credentials and editor/OS debris must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
*~
